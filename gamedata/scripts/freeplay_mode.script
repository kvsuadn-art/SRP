-- Freeplay mode: the single source of truth for "is Freeplay active".
--
-- The mode is stored as the info portion below, NOT as a Lua variable:
-- info portions are written to savegames, Lua variables are not.
--
-- Until the main menu gets a Freeplay entry, the mode is switched on at the start
-- of a new game by [freeplay] enabled = true in misc\freeplay.ltx.
-- The future menu entry should simply call freeplay_mode.enable() instead.

local INFO = "srp_freeplay"

function is_freeplay()
	return has_alife_info(INFO)
end

function enable()
	if not has_alife_info(INFO) then
		db.actor:give_info_portion(INFO)
	end
end

-- Called once per new game from bind_stalker, in actor_binder:net_spawn, i.e. before any object's logic is
-- initialized: restrictors and NPCs initialize their logic on their own first update and must already see
-- the mode flag, otherwise they would start in their story sections.
function on_new_game()
	local ini = ini_file("misc\\freeplay.ltx")
	if utils.cfg_get_bool(ini, "freeplay", "enabled", nil, false, false) then
		enable()
	end
end

-- Gives the Freeplay starting kit (misc\freeplay.ltx [start_equipment]) to the actor, once per game.
function give_start_equipment()
	local EQUIPPED = "srp_freeplay_equipped"
	if has_alife_info(EQUIPPED) then
		return
	end
	local act = db.actor
	local ini = ini_file("misc\\freeplay.ltx")
	local sim = alife()
	if act and sim and ini:section_exist("start_equipment") then
		local pos, lvid, gvid, id = act:position(), act:level_vertex_id(), act:game_vertex_id(), act:id()
		for i = 0, ini:line_count("start_equipment") - 1 do
			local result, section, value = ini:r_line("start_equipment", i, "", "")
			local count = tonumber(value) or 1
			if string.find(section, "^ammo_") then
				sim:create_ammo(section, pos, lvid, gvid, id, count)
			else
				for n = 1, count do
					sim:create(section, pos, lvid, gvid, id)
				end
			end
		end
	end
	act:give_info_portion(EQUIPPED)
end
