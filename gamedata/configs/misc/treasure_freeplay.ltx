; Freeplay treasures: items that the original game hands out only as rewards of story quests.
; Each section reuses an existing inventory box (target) and is sold through the generic treasure dialog,
; the same way as the other *_quest_treasure_* sections. Offered only when the info portion srp_freeplay is set.
; NOTE: the number of sections is written into savegames (treasure_manager.save), so saves made before this file was added are incompatible.

[list_treasure_freeplay]
fp_mar_flash_bd_mp5
fp_mar_flash_novice_outfit
fp_mar_cs_light_outfit
fp_val_flash_abcd_svu
fp_agr_flash_abcd_pkm
fp_red_wpn_fn2000

[fp_mar_flash_bd_mp5]
target = mar_q_t_l_4
name = st_fp_treasure_flash
description = st_mar_q_t_l_4_descr
items = flesh_up_bd_mp5, 1
condlist = {+srp_freeplay =actor_on_level(marsh)} true, false
treasure_cost = 800
say_item_name = true

