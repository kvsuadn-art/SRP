[logic]
active = {+srp_freeplay} remark@fp_scene_2_skip_talk, remark@scene_2_window_idle_2

[remark@scene_2_window_idle_2]
anim = mar_intro_2_window_idle
on_timer = 10000 | remark@scene_2_walk_talk
meet = no_meet

[remark@scene_2_walk_talk]
anim = mar_intro_2_talk_idle
on_timer = 1500 | remark@scene_2_walk_main %=play_sound(mar_intro_scene_2_lebedev:csky:mar_csky_commander_name)%
meet = no_meet

[remark@scene_2_walk_main]
anim = mar_intro_2_talk_idle
on_signal = anim_end | remark@scene_2_talk_standing_1
meet = no_meet

[remark@scene_2_talk_standing_1]
anim = mar_intro_2_talk_idle
on_info = {=talking} remark@scene_2_talk_standing_2
meet = meet@talking

[remark@scene_2_talk_standing_2]
anim = mar_intro_2_talk_idle
on_info = {!talking} remark@scene_2_finish %=disable_ui_elements(input)%
meet = meet@talking

[remark@scene_2_finish]
anim = mar_intro_2_walk_out
meet = no_meet
on_timer = 9500 | nil %+mar_intro_scene_2_end =destroy_object%

[meet@talking]
meet_state = 0 | mar_intro_2_talk_idle
meet_state_wpn = 0 | mar_intro_2_talk_idle
victim = 0 | nil
victim_wpn = 0 | nil
use = self
use_wpn = self
precond = usability
meet_only_at_path = false
trade_enable = false
allow_break = false
;=======================================================================
; FREEPLAY BLOCK (srp_freeplay). Entered from [logic] active; the story sections above are untouched.
; Lebedev does not wait for the player to talk to him: +mar_intro_scene_2_end is given at once (the zone
; needs it, together with the camera effector end, to hand control to the player), and he walks out and
; disappears on his own.
;=======================================================================

[remark@fp_scene_2_skip_talk]
anim = mar_intro_2_window_idle
on_timer = 1 | remark@fp_scene_2_finish %+mar_intro_scene_2_end%
meet = no_meet

[remark@fp_scene_2_finish]
anim = mar_intro_2_walk_out
meet = no_meet
on_timer = 9500 | nil %=destroy_object%
