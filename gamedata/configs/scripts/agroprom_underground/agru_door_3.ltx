; Copy of the IXRay-adapted file (original CS file was not in the repo) with a Freeplay alternative added.
[collide]
ignore_static

[logic]
active = {+srp_freeplay} ph_door@open, ph_door@locked

[ph_door@locked]
locked = true
closed = true
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+agru_leader_dolg_task_complete} ph_door@open

[ph_door@open]
locked = false
closed = false
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
