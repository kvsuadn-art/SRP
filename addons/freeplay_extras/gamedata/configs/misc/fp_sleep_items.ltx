; Freeplay extras: sleeping bag item (included from system.ltx). Idea: SGM (sgm sleeping_bag). Adaptation SRP Freeplay: Eon. Effect: scripts\fp_sleep.script, settings: misc\fp_sleep.ltx

; the sleeping bag (SGM: sleeping_bag). Used like food; the module checks the place and the time of day.
[sleeping_bag]:identity_immunities
GroupControlSection = spawn_group
discovery_dependency =
$spawn = "device\skill_book"
class = II_FOOD
cform = skeleton
visual = dynamics\equipments\documents_2.ogf
description = sleeping_bag_descr
inv_name = sleeping_bag_title
inv_name_short = sleeping_bag_title
cost = 0
inv_weight = 0
can_trade = false
inv_grid_width = 2
inv_grid_height = 2
inv_grid_x = 10
inv_grid_y = 25
eat_health = 0
eat_satiety = 0
eat_power = 0
eat_radiation = 0
wounds_heal_perc = 0
eat_portions_num = 1

; The sleeping place in the world: an invisible object (0.4 x 0.2 x 0.5 m) over a bed or mattress, "F" shows the tip and opens the sleep window.
; Idea and model: "New Sleep Mod for R.M.A. 1.1.5" (Mechanic, Shoker, Z.E.N., Ab@dDon, Junk): section [mattress], model sleeping_decor_inviz.ogf.
; Adaptation SRP Freeplay: Eon. The hook (callback.use_object) is set by scripts\fp_sleep.script, not by script_binding.
; Without a parent: the includes of system.ltx are read before [script_object] (parent sections are not guaranteed to exist yet);
; the keys are copied from [script_object] of system.ltx.
[fp_mattress]
GroupControlSection = spawn_group
$spawn = "script\script object"
$npc = on
Scheduled = on
Human = off
cform = skeleton
class = SCRPTOBJ
visual = physics\decor\sleeping_decor_inviz.ogf
