; Quests ported from SGM ideas (see scripts\fp_quests.script). Adaptation SRP Freeplay: Eon
; type = fetch: item spawns at 'spawn' (x,y,z,level_vertex,game_vertex) when the quest starts, actor brings it to 'giver' (NPC name).

[quests]
esc_shilov_find_rukzak
esc_capture_army_blockpost
mar_capture_pumping_station
mar_capture_church
mar_capture_boat_station
mar_capture_embankment
mar_capture_north_khutor
mar_last_intensify_reward

; Escape: the base mechanic (Fourgon) lost his rucksack in the loners' camp (SGM: esc_shilov_find_rukzak)
[esc_shilov_find_rukzak]
type = fetch
giver = esc_stalker_mechanic
item = shilov_rukzak
spawn = -200.732,-16.617,-160.797,51907,569
reward_money = 2000
reward_items = medkit, skill_book_pm

; Escape: take the army blockpost (smart esc_smart_terrain_3_16) from the military; the leader of the stalker base gives it
; (SGM: esc_take_equipments + esc_capture_army_blockpost; the equipment/reinforcement steps are dropped)
[esc_capture_army_blockpost]
type = capture
faction = stalker
giver = esc_stalker_leader
smart = esc_smart_terrain_3_16
enemy = army
reward_money = 3000
reward_items = stalker_outfit, skill_book_abakan, skill_book_ak74u

