; Части мутантов OGSM Extended 2.0, отсутствующие в оригинале. Адаптация под SRP Freeplay: Eon
; Подключается из system.ltx после misc\monster_items.ltx (нужен родитель identity_immunities).

[mutant_tushkano_head]:identity_immunities
GroupControlSection		= spawn_group
discovery_dependency 	= 
$spawn 					= "devices\monster_items\mutant_tushkano_head"
class					= II_ATTCH
cform					= skeleton
visual					= dynamics\equipments\item_tushkano_head.ogf
radius					= 1

description				= mutant_tushkano_head_description
inv_name				= mutant_tushkano_head
inv_name_short			= mutant_tushkano_head

inv_grid_width			= 1
inv_grid_height			= 1
inv_grid_x				= 4
inv_grid_y				= 38

inv_weight				= 0.25

cost					= 250

can_trade				= on

