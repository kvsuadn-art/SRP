; Freeplay extras: sleep in known places. Idea, points and zones: SGM (Sigerous Mod 3.10, GeJorge, sgm_sleep_places / sgm_callbacks).
; Adaptation SRP Freeplay: Eon. Beds and mattresses are not objects of the game or of all.spawn, so SGM's author walked to them
; and recorded the coordinates by hand; they are kept as they are. A place is allowed if the actor is within radius_sqr (squared
; metres, 20 = about 4.5 m, as in SGM's code) of a point of the current level, or inside a zone (space restrictor) listed for it,
; or the whole level is listed in [levels]. Effect: scripts\fp_sleep.script.

[settings]
radius_sqr = 20
night_from = 21
night_to = 6
min_hours = 1
max_hours = 6
time_factor = 1700

[levels]
limansk
hospital

