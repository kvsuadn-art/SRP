<?xml version="1.0" encoding="windows-1251" ?>
<game_dialogs>
<!-- Адаптация под SRP Freeplay: Eon. Доступны только во Фриплее (ogsm_rt_manager.is_enabled). -->

	<dialog id="rt_courier_dialog">
		<precondition>ogsm_rt_manager.is_enabled</precondition>
		<precondition>ogsm_rt_manager.precondition_courier</precondition>
		<phrase_list>
			<phrase id="0">
				<text>Приветствую. Пришёл за продуктами, ты должен быть в курсе...</text>
				<next>1</next>
			</phrase>
			<phrase id="1">
				<text>Сидорович, то есть я сам, всегда в курсе. Получите и распишитесь...</text>
				<action>ogsm_rt_manager.action_give_packet</action>
				<next>2</next>
			</phrase>
			<phrase id="2">
				<text>Побежал.</text>
				<action>dialogs.break_dialog</action>
			</phrase>
		</phrase_list>
	</dialog>

	<!-------------------------------------------------->

	<dialog id="rt_squad_courier_dialog">
		<precondition>ogsm_rt_manager.is_enabled</precondition>
		<precondition>ogsm_rt_manager.precondition_squad_courier</precondition>
		<phrase_list>
			<phrase id="0">
				<text>Я от главного, по поводу боеприпасов.</text>
				<next>1</next>
			</phrase>
			<phrase id="1">
				<text>Уже в курсе, вот твоя посылочка. Координаты отряда скидываю тебе в КПК, поторопись.</text>
				<action>ogsm_rt_manager.action_take_ammo_packet</action>
				<next>2</next>
			</phrase>
			<phrase id="2">
				<text>Побежал.</text>
				<action>dialogs.break_dialog</action>
			</phrase>
		</phrase_list>
	</dialog>

	<!-------------------------------------------------->

	<dialog id="rt_to_squad">
		<precondition>ogsm_rt_manager.is_enabled</precondition>
	<precondition>ogsm_rt_manager.squad_courier_has_item</precondition>
	<phrase_list>
		<phrase id="0">
			<text>Ты к нам по делу, наёмник, или как?</text>
			<next>1</next>
		</phrase>
		<phrase id="1">
			<text>Я боеприпасы принёс. Принимайте, братцы!</text>
			<next>11</next>
		</phrase>
		<phrase id="11">
			<text>Отлично, уже заждались!</text>
			<action>ogsm_rt_manager.squad_courier_dlg_action</action>
		</phrase>
	</phrase_list>
	</dialog>

	<!-------------------------------------------------->

	<!-- диалог отсрочен до возвращения Шрама из первого похода к наблюдательной вышке -->
