<?xml version="1.0" encoding="windows-1251" ?>
<!-- Dialogs of fp_quests (quests ported from SGM ideas). Adaptation SRP Freeplay: Eon. Dialog id = <quest>_give / <quest>_complete -->
<game_dialogs>
	<dialog id="esc_shilov_find_rukzak_give">
		<precondition>fp_quests.gate_dialog</precondition>
		<dont_has_info>esc_shilov_find_rukzak_start</dont_has_info>
		<phrase_list>
			<phrase id="0">
				<text>esc_shilov_find_rukzak_dialog_1</text>
				<next>1</next>
			</phrase>
			<phrase id="1">
				<text>esc_shilov_find_rukzak_dialog_2</text>
				<next>100</next>
				<next>200</next>
			</phrase>
			<phrase id="100">
				<text>esc_shilov_find_rukzak_dialog_3</text>
				<action>fp_quests.start</action>
				<action>dialogs.break_dialog</action>
			</phrase>
			<phrase id="200">
				<text>esc_shilov_find_rukzak_dialog_4</text>
				<action>dialogs.break_dialog</action>
			</phrase>
		</phrase_list>
	</dialog>
	<dialog id="esc_shilov_find_rukzak_complete">
		<precondition>fp_quests.gate_dialog</precondition>
		<precondition>fp_quests.has_esc_shilov_find_rukzak_item</precondition>
		<has_info>esc_shilov_find_rukzak_start</has_info>
		<dont_has_info>esc_shilov_find_rukzak_reward</dont_has_info>
		<phrase_list>
			<phrase id="0">
				<text>esc_shilov_find_rukzak_dialog_5</text>
				<action>fp_quests.finish</action>
				<next>1</next>
			</phrase>
			<phrase id="1">
				<text>esc_shilov_find_rukzak_dialog_6</text>
			</phrase>
		</phrase_list>
	</dialog>
</game_dialogs>
