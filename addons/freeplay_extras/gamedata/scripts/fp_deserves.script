-- fp_deserves: leaders' things. Idea, texts and stash coordinates: SGM (Sigerous Mod 3.10, GeJorge, sgm_callbacks / deserve_items).
-- Adaptation SRP Freeplay: Eon
--
-- A leader carries a flash drive dv_<name>_case (misc\fp_deserves.ltx). "Using" it creates a stash (inventory_box) at
-- deserve_pos with deserve_items, adds a map spot and a tip. Unlike SGM no item callbacks in the actor binder are needed.
-- Switch: info portion srp_freeplay or fp_deserves. Cost: one on_item_use subscriber, nothing per update.
-- Savegame: nothing of its own (the stash is a normal server object, the spot is saved with the level).

local function is_enabled()
	return has_alife_info("srp_freeplay") or has_alife_info("fp_deserves")
end

function attach(m)
	m:subscribe({ signal = "on_item_use", fun = on_item_use })
end

function on_item_use(obj)
	if not is_enabled() then return end
	local sect = obj:section()
	if not string.find(sect, "^dv_.+_case$") then return end
	local ini = system_ini()
	if not ini:line_exist(sect, "deserve_pos") then return end
	local x, y, z, lv, gv = string.match(ini:r_string(sect, "deserve_pos"),
		"([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*(%d+)%s*,%s*(%d+)")
	local box = alife():create("inventory_box", vector():set(tonumber(x), tonumber(y), tonumber(z)), tonumber(lv), tonumber(gv))
	if box == nil then return end
	local list = {}
	for s in string.gmatch(ini:r_string(sect, "deserve_items"), "[^,%s]+") do list[#list + 1] = s end
	local i = 1
	while i <= #list do
		local section, n = list[i], 1
		if tonumber(list[i + 1] or "") then n = tonumber(list[i + 1]) i = i + 1 end
		if ini:line_exist(section, "box_size") then
			se_respawn.create_ammo(section, vector(), 0, 0, box.id, n)
		else
			for _ = 1, n do alife():create(section, vector(), 0, 0, box.id) end
		end
		i = i + 1
	end
	if level.map_has_object_spot(box.id, "treasure") == 0 then
		level.map_add_object_spot_ser(box.id, "treasure", game.translate_string(ini:r_string(sect, "deserve_descr")))
	end
	news_manager.send_tip(db.actor, game.translate_string("st_fp_deserve_tip") .. " " .. game.translate_string(ini:r_string(sect, "deserve_title")))
end
