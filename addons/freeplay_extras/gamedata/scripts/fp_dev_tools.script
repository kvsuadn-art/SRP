-- Freeplay extras: developer tools for the naxac window (tabs "Телепорт" and "Инструменты").
-- No window of its own: ui_cheat_cs asks this module for the list of a tab (list), the text for the description
-- area (describe) and runs the chosen entry with the same "Получить" button (run).
-- Teleport targets are taken from SRP's own guide data (guiders_table): the cross-level points
-- (cross_level_teleport) and the guide points of the current level (teleport_points). The jump itself is
-- the one SRP guides use: db.actor:set_actor_position(patrol point).
-- Adaptation for SRP Freeplay: Eon

local TAG = "[fp_dev_tools] "
local tf_default = 10

local tools = {
	{ key = "pos",     name = "Координаты в лог",       descr = "Записать в лог положение игрока: уровень, позицию, level/game vertex, направление." },
	{ key = "h1",      name = "Время +1 час",           descr = "Сдвинуть игровое время на час вперёд." },
	{ key = "h6",      name = "Время +6 часов",         descr = "Сдвинуть игровое время на 6 часов вперёд." },
	{ key = "d1",      name = "Время +1 сутки",         descr = "Сдвинуть игровое время на сутки вперёд." },
	{ key = "tf2",     name = "Таймфактор x2",          descr = "Ускорить игровое время вдвое (максимум 1000)." },
	{ key = "tf1",     name = "Таймфактор по умолчанию", descr = "Вернуть таймфактор " .. tf_default .. "." },
	{ key = "heal",    name = "Здоровье и деньги",      descr = "Восстановить здоровье, выносливость, психику, убрать радиацию и кровотечение, +100000 руб." },
	{ key = "surge",   name = "Запустить выброс",       descr = "Немедленно запустить выброс (30 сек. до укрытия), если он сейчас не идёт." },
	{ key = "eclipse", name = "Запустить затмение",     descr = "Выброс с эффектом затмения (fx_blackday)." },
}

local function tip(text)
	news_manager.send_tip(db.actor, text)
end

-- list of a tab: array of { key, name, descr }
-- "teleport": every guide point of guiders_table on every level, named the way guides name them:
-- "<level>. <point name>", both localized.
local function teleport_list()
	local res = {}
	local cur = level.name()
	local smarts = sim_board.get_sim_board().smarts_by_names
	for name, d in pairs(guiders_table.teleport_points) do
		local smart = smarts[name]
		if smart then
			local ok, label = pcall(smart_names.get_smart_terrain_name, smart)
			if not ok or not label then label = name end
			local lvl = game.translate_string(d.level)
			res[#res + 1] = {
				key = name,
				name = lvl .. ". " .. label,
				descr = (d.level == cur) and "Точка на этом уровне." or "Точка на другом уровне: сначала переход на уровень (консольная команда jump_to_level), затем прыжок к точке.",
				here = (d.level == cur) and 0 or 1,
				lvl = lvl,
			}
		end
	end
	table.sort(res, function(a, b)
		if a.here ~= b.here then return a.here < b.here end
		if a.lvl ~= b.lvl then return a.lvl < b.lvl end
		return a.name < b.name
	end)
	return res
end

function list(tab)
	if tab == "tools" then return tools end
	if tab == "teleport" then return teleport_list() end
	return {}
end

function describe(tab, key)
	local t = list(tab)
	for i = 1, #t do
		if t[i].key == key then return t[i].descr end
	end
	return ""
end

-- The jump inside a level is done by SRP's own guide code: guiders.start_teleport (fade, control back at the end).
-- To another level the guides' own way is used (guiders.action_teleport_to_point): the player is put onto the
-- patrol point guiders_table.cross_level_teleport[current][target], which lies inside a level changer zone, so the
-- engine itself loads the next level. On the new level the same guide jump goes to the exact point. The target is
-- kept in the savegame for that: "pending" (one string, empty when nothing is pending; the Lua state is rebuilt on
-- a level change, SRP's own guiders.save/load work the same way).
local pending = ""
local entry_time = 0
local started = 0
local ARRIVE_WAIT = 2000
local FAIL_WAIT = 8000
local mgr = nil

function attach(m)
	mgr = m
	m:subscribe({ signal = "on_save", fun = on_save })
	m:subscribe({ signal = "on_load", fun = on_load })
	m:subscribe({ signal = "on_net_spawn", fun = on_net_spawn })
	m:subscribe({ signal = "on_update", fun = on_update })
end

function on_save(packet)
	packet:w_stringZ(pending)
end

function on_load(reader)
	pending = reader:r_stringZ()
end

function on_net_spawn()
	entry_time = time_global()
	if pending ~= "" then
		local d = guiders_table.teleport_points[pending]
		if not (d and d.level == level.name()) then pending = "" end   -- stale target (the level change did not happen)
	end
end

local function jump_to(key)
	local d = guiders_table.teleport_points[key]
	local point, look = d.point, d.look
	if not (point and look) then
		point, look = key .. "_kamp_1", key .. "_kamp_1_task"
	end
	guiders.start_teleport(point, look)
end

function on_update(delta)
	mgr:reschedule(1000)
	if pending == "" or not (db.actor and db.actor:alive()) then return end
	local key = pending
	local d = guiders_table.teleport_points[key]
	if not d then pending = ""; return end
	if d.level == level.name() then
		if time_global() - entry_time < ARRIVE_WAIT then return end
		pending = ""
		guiders.teleported_to_another_level = false   -- the guides' own second step has nothing to do here
		guiders.level_changed = false
		jump_to(key)
		dbglog("%s", TAG .. "arrived, second step to " .. key)
	elseif started > 0 and time_global() - started > FAIL_WAIT then
		-- the level did not change (level changer closed): give the control back
		pending = ""
		started = 0
		guiders.teleported_to_another_level = false
		guiders.teleport_end()
		level.add_pp_effector("peace_unfade.ppe", 160608, false)
		tip("Переход закрыт (уровень не сменился)")
		dbglog("%s", TAG .. "level change failed for " .. key)
	end
end

local function teleport(key)
	local d = guiders_table.teleport_points[key]
	if not d then return false end
	local cur = level.name()
	if d.level == cur then
		jump_to(key)
	else
		local cross = guiders_table.cross_level_teleport[cur] and guiders_table.cross_level_teleport[cur][d.level]
		if not cross then
			tip("Нет перехода " .. cur .. " -> " .. d.level)
			return false
		end
		pending = key
		started = time_global()
		guiders.level_changed = true
		guiders.start_teleport(cross, nil)
	end
	dbglog("%s", TAG .. "teleport to " .. key .. " (" .. tostring(d.level) .. ")")
	return true
end

local function change_time(h, text)
	local ok = pcall(level.change_game_time, 0, h, 0)
	tip(ok and text or "level.change_game_time недоступна в этом движке")
end

local function log_pos()
	local act = db.actor
	local lvid, gvid = act:level_vertex_id(), act:game_vertex_id()
	local pos = level.vertex_position(lvid)
	local dir = act:direction()
	local msg = string.format("%s pos=vector():set(%.3f,%.3f,%.3f), lvid=%d, gvid=%d, dir=vector():set(%.3f,%.3f,%.3f)",
		level.name(), pos.x, pos.y, pos.z, lvid, gvid, dir.x, dir.y, dir.z)
	dbglog("%s", TAG .. msg)
	tip("Координаты записаны в лог")
end

-- Runs an entry. Returns true when the window must be closed (the action needs the game to continue).
function run(tab, key)
	if not (db.actor and db.actor:alive()) then return false end
	if tab == "teleport" then
		return teleport(key)
	end
	if key == "pos" then log_pos(); return false
	elseif key == "h1" then change_time(1, "Время +1 ч"); return true
	elseif key == "h6" then change_time(6, "Время +6 ч"); return true
	elseif key == "d1" then change_time(24, "Время +1 сутки"); return true
	elseif key == "tf2" then
		local tf = math.min(level.get_time_factor() * 2, 1000)
		level.set_time_factor(tf)
		tip("Таймфактор " .. tf)
	elseif key == "tf1" then
		level.set_time_factor(tf_default)
		tip("Таймфактор " .. tf_default)
	elseif key == "heal" then
		local act = db.actor
		act.health = 0.99
		act.bleeding = 0.99
		act.power = 0.99
		act.psy_health = 0.99
		act.radiation = -1.0
		act:give_money(100000)
		tip("Здоровье восстановлено, +100000 руб.")
	elseif key == "surge" then
		tip(fp_surge.force(30, false)); return true
	elseif key == "eclipse" then
		tip(fp_surge.force(30, true)); return true
	end
	return false
end
