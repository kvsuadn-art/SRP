-- Freeplay extras: developer tools for the naxac window (tabs "Телепорт" and "Инструменты").
-- No window of its own: ui_cheat_cs asks this module for the list of a tab (list), the text for the description
-- area (describe) and runs the chosen entry with the same "Получить" button (run).
-- Teleport targets are taken from SRP's own guide data (guiders_table): the cross-level points
-- (cross_level_teleport) and the guide points of the current level (teleport_points). The jump itself is
-- the one SRP guides use: db.actor:set_actor_position(patrol point). guiders.start_teleport is not used (its fade chain
-- and level.show_weapon are not needed for a tool, the first version without them worked).
-- Adaptation for SRP Freeplay: Eon

local TAG = "[fp_dev_tools] "
local tf_default = 10
local BUILD = "2026-11-28 b5"

local tools = {
	{ key = "pos",     name = "Координаты в лог",       descr = "Записать в лог положение игрока: уровень, позицию, level/game vertex, направление." },
	{ key = "mat",    name = "Точка матраса в лог",    descr = "Записать в лог строку для misc\\fp_sleep.ltx: позиция пола под ногами, вершины, угол. Встаньте там, где должен лежать матрас, лицом вдоль него." },
	{ key = "ray1",   name = "Матрас по взгляду: луч 1",  descr = "Навести перекрестие на матрас (хоть на верхнем ярусе) и запомнить направление взгляда. Затем отойти на 2-3 метра в сторону, навести на ту же точку и нажать «луч 2»." },
	{ key = "ray2",   name = "Матрас по взгляду: луч 2",  descr = "Второй взгляд на ту же точку матраса: по двум лучам считается точка в пространстве (с высотой) и пишется в лог строка для misc\\fp_sleep.ltx." },
	{ key = "h1",      name = "Время +1 час",           descr = "Сдвинуть игровое время на час вперёд." },
	{ key = "h6",      name = "Время +6 часов",         descr = "Сдвинуть игровое время на 6 часов вперёд." },
	{ key = "d1",      name = "Время +1 сутки",         descr = "Сдвинуть игровое время на сутки вперёд." },
	{ key = "tf2",     name = "Таймфактор x2",          descr = "Ускорить игровое время вдвое (максимум 1000)." },
	{ key = "tf1",     name = "Таймфактор по умолчанию", descr = "Вернуть таймфактор " .. tf_default .. "." },
	{ key = "heal",    name = "Здоровье и деньги",      descr = "Восстановить здоровье, выносливость, психику, убрать радиацию и кровотечение, +100000 руб." },
	{ key = "surge",   name = "Запустить выброс",       descr = "Немедленно запустить выброс (30 сек. до укрытия), если он сейчас не идёт." },
	{ key = "eclipse", name = "Запустить затмение",     descr = "Выброс с эффектом затмения (fx_blackday)." },
	{ key = "diag",    name = "Диагностика в лог",      descr = "Записать в лог состояние модулей Freeplay: тайник, сон, зона базы, версия сборки." },
}

local function tip(text)
	news_manager.send_tip(db.actor, text)
end

-- list of a tab: array of { key, name, descr }
-- "teleport": every guide point of guiders_table on every level, named the way guides name them:
-- "<level>. <point name>", both localized.
local function teleport_list()
	local res = {}
	local cur = level.name()
	local smarts = sim_board.get_sim_board().smarts_by_names
	for name, d in pairs(guiders_table.teleport_points) do
		local smart = smarts[name]
		if smart then
			local ok, label = pcall(smart_names.get_smart_terrain_name, smart)
			if not ok or not label then label = name end
			local lvl = game.translate_string(d.level)
			res[#res + 1] = {
				key = name,
				name = lvl .. ". " .. label,
				descr = (d.level == cur) and "Точка на этом уровне." or "Точка на другом уровне: сначала переход через зону перехода, как у проводников, затем прыжок к точке.",
				here = (d.level == cur) and 0 or 1,
				lvl = lvl,
			}
		end
	end
	table.sort(res, function(a, b)
		if a.here ~= b.here then return a.here < b.here end
		if a.lvl ~= b.lvl then return a.lvl < b.lvl end
		return a.name < b.name
	end)
	return res
end

function list(tab)
	if tab == "tools" then return tools end
	if tab == "teleport" then return teleport_list() end
	return {}
end

function describe(tab, key)
	local t = list(tab)
	for i = 1, #t do
		if t[i].key == key then return t[i].descr end
	end
	return ""
end

-- The jump inside a level: a direct move onto the guide's patrol point.
-- To another level the guides' own way is used (guiders.action_teleport_to_point): the player is put onto the
-- patrol point guiders_table.cross_level_teleport[current][target], which lies inside a level changer zone, so the
-- engine itself loads the next level. On the new level the same guide jump goes to the exact point. The target is
-- kept in the savegame for that: "pending" (one string, empty when nothing is pending; the Lua state is rebuilt on
-- a level change, SRP's own guiders.save/load work the same way).
local pending = ""
local entry_time = 0
local started = 0
local ARRIVE_WAIT = 2000
local FAIL_WAIT = 8000
local mgr = nil

function attach(m)
	mgr = m
	m:subscribe({ signal = "on_net_spawn", fun = on_net_spawn })
	m:subscribe({ signal = "on_update", fun = on_update })
end

-- The target is kept as an info portion fp_tp_<index of the key in the sorted list of guide points> (savegame-safe: no
-- chunk of its own, so saves made by other versions keep loading).
local function keys()
	local t = {}
	for k in pairs(guiders_table.teleport_points) do t[#t + 1] = k end
	table.sort(t)
	return t
end

local function get_pending()
	local t = keys()
	for i = 1, math.min(#t, 128) do
		if has_alife_info("fp_tp_" .. (i - 1)) then return t[i], i - 1 end
	end
	return ""
end

local function set_pending(key)
	local t = keys()
	for i = 1, math.min(#t, 128) do
		local id = "fp_tp_" .. (i - 1)
		if t[i] == key then
			if not has_alife_info(id) then db.actor:give_info_portion(id) end
		elseif has_alife_info(id) then
			db.actor:disable_info_portion(id)
		end
	end
	pending = key
end

function on_net_spawn()
	entry_time = time_global()
	dbglog("%s", TAG .. "build " .. BUILD)
	pending = get_pending()
	if pending ~= "" then
		local d = guiders_table.teleport_points[pending]
		if not (d and d.level == level.name()) then set_pending("") end   -- stale target (the level change did not happen)
	end
end

-- Direct move, as in the first (working) version: set_actor_position at once, no effector chain that could
-- fail to come back while the tool window is closing. The fade is only cosmetic.
local function give_back_control()
	pcall(level.enable_input)
	pcall(level.show_indicators)
end

local function begin_jump(point, look, cross)
	if not level.patrol_path_exists(point) then
		tip("Нет точки пути: " .. tostring(point))
		dbglog("%s", TAG .. "patrol point missing: " .. tostring(point))
		return false
	end
	local act = db.actor
	local pnt = patrol(point)
	act:set_actor_position(pnt:point(0))
	if look and level.patrol_path_exists(look) then
		local dir = patrol(look):point(0):sub(pnt:point(0))
		act:set_actor_direction(-dir:getH())
	end
	pcall(level.add_pp_effector, "peace_unfade.ppe", 160608, false)
	if cross then started = time_global() end   -- waiting for the engine's level change
	dbglog("%s", TAG .. "moved to " .. point .. (cross and " (level changer)" or ""))
	return true
end

local function jump_to(key)
	local d = guiders_table.teleport_points[key]
	local point, look = d.point, d.look
	if not (point and look) then
		point, look = key .. "_kamp_1", key .. "_kamp_1_task"
	end
	return begin_jump(point, look, false)
end

function on_update(delta)
	mgr:reschedule(1000)
	if not (db.actor and db.actor:alive()) then return end
	if pending == "" then return end
	local key = pending
	local d = guiders_table.teleport_points[key]
	if not d then set_pending(""); return end
	if d.level == level.name() then
		if time_global() - entry_time < ARRIVE_WAIT then return end
		set_pending("")
		started = 0
		jump_to(key)
		dbglog("%s", TAG .. "arrived, second step to " .. key)
	elseif started > 0 and time_global() - started > FAIL_WAIT then
		-- the level did not change (level changer closed): give the control back
		set_pending("")
		started = 0
		give_back_control()
		tip("Переход закрыт (уровень не сменился)")
		dbglog("%s", TAG .. "level change failed for " .. key)
	end
end

local function teleport(key)
	local d = guiders_table.teleport_points[key]
	if not d then return false end
	local cur = level.name()
	if d.level == cur then
		if not jump_to(key) then return false end
	else
		local cross = guiders_table.cross_level_teleport[cur] and guiders_table.cross_level_teleport[cur][d.level]
		if not cross then
			tip("Нет перехода " .. cur .. " -> " .. d.level)
			return false
		end
		set_pending(key)
		started = 0
		if not begin_jump(cross, nil, true) then set_pending(""); return false end
	end
	dbglog("%s", TAG .. "teleport to " .. key .. " (" .. tostring(d.level) .. ")")
	return true
end

local function diag()
	local act = db.actor
	local p = act:position()
	local function inf(s) return s .. "=" .. tostring(has_alife_info(s)) end
	dbglog("%s", TAG .. "DIAG build " .. BUILD .. " level=" .. level.name() .. string.format(" pos=%.1f,%.1f,%.1f hour=%d", p.x, p.y, p.z, level.get_time_hours()))
	dbglog("%s", TAG .. "DIAG infos: " .. inf("srp_freeplay") .. " " .. inf("fp_sleep") .. " " .. inf("fp_stash") .. " " .. inf("fp_stash_done") .. " " .. inf("fp_stash_done2"))
	local zn = "mar_space_restrictor_csky_base_noweapon"
	local z = db.zone_by_name[zn]
	dbglog("%s", TAG .. "DIAG zone " .. zn .. " registered=" .. tostring(z ~= nil) .. " inside=" .. tostring(z ~= nil and z:inside(p)))
	local ok, a, b = pcall(function() return fp_sleep.is_enabled(), fp_sleep.in_place() end)
	dbglog("%s", TAG .. "DIAG sleep: " .. tostring(ok) .. " enabled=" .. tostring(a) .. " in_place=" .. tostring(b))
	dbglog("%s", TAG .. "DIAG sleeping_bag in inventory=" .. tostring(act:object("sleeping_bag") ~= nil))
	local old = alife():object("mar_physic_object_0039")
	dbglog("%s", TAG .. "DIAG decorative rucksack mar_physic_object_0039 exists=" .. tostring(old ~= nil))
	local n = 0
	for i = 0, 65534 do
		local se = alife():object(i, true)
		if se and se:section_name() == "fp_base_stash" then
			n = n + 1
			dbglog("%s", TAG .. "DIAG fp_base_stash id=" .. se.id .. string.format(" pos=%.1f,%.1f,%.1f", se.position.x, se.position.y, se.position.z))
		end
	end
	dbglog("%s", TAG .. "DIAG fp_base_stash count=" .. n)
	tip("Диагностика записана в лог")
end

local function change_time(h, text)
	local ok = pcall(level.change_game_time, 0, h, 0)
	tip(ok and text or "level.change_game_time недоступна в этом движке")
end

local function log_pos()
	local act = db.actor
	local lvid, gvid = act:level_vertex_id(), act:game_vertex_id()
	local pos = level.vertex_position(lvid)
	local dir = act:direction()
	local msg = string.format("%s pos=vector():set(%.3f,%.3f,%.3f), lvid=%d, gvid=%d, dir=vector():set(%.3f,%.3f,%.3f)",
		level.name(), pos.x, pos.y, pos.z, lvid, gvid, dir.x, dir.y, dir.z)
	dbglog("%s", TAG .. msg)
	tip("Координаты записаны в лог")
end

local mat_n = 0
local ray1 = nil

-- two camera rays at the same spot give its position in space (the engine export of this build has no ray cast)
local function cam_ray()
	local d = device()
	local p, v = d.cam_pos, d.cam_dir
	return { px = p.x, py = p.y, pz = p.z, dx = v.x, dy = v.y, dz = v.z }
end

local function ray_point(r1, r2)
	local wx, wy, wz = r1.px - r2.px, r1.py - r2.py, r1.pz - r2.pz
	local b = r1.dx * r2.dx + r1.dy * r2.dy + r1.dz * r2.dz
	local d = r1.dx * wx + r1.dy * wy + r1.dz * wz
	local e = r2.dx * wx + r2.dy * wy + r2.dz * wz
	local den = 1 - b * b
	if den < 0.02 then return nil, "лучи почти параллельны: отойдите в сторону на 2-3 м" end
	local s = (b * e - d) / den
	local u = (e - b * d) / den
	local q1 = { r1.px + r1.dx * s, r1.py + r1.dy * s, r1.pz + r1.dz * s }
	local q2 = { r2.px + r2.dx * u, r2.py + r2.dy * u, r2.pz + r2.dz * u }
	local gap = math.sqrt((q1[1] - q2[1]) ^ 2 + (q1[2] - q2[2]) ^ 2 + (q1[3] - q2[3]) ^ 2)
	if s < 0 or u < 0 then return nil, "точка позади камеры: наведите на одну и ту же точку" end
	return { (q1[1] + q2[1]) / 2, (q1[2] + q2[2]) / 2, (q1[3] + q2[3]) / 2 }, gap
end

local function log_ray(first)
	if first then
		ray1 = cam_ray()
		tip("Луч 1 запомнен. Отойдите в сторону и наведите на ту же точку")
		return
	end
	if not ray1 then tip("Сначала «луч 1»"); return end
	local pt, gap = ray_point(ray1, cam_ray())
	if not pt then tip(gap); return end
	local act = db.actor
	local lvid = level.vertex_id(vector():set(pt[1], pt[2], pt[3]))
	local gvid = act:game_vertex_id()
	local dir = act:direction()
	mat_n = mat_n + 1
	dbglog("%s", TAG .. string.format("MATTRESS %s: m%d = %.3f,%.3f,%.3f,%d,%d,%.3f   ; rays gap %.2f m", level.name(), mat_n, pt[1], pt[2], pt[3], lvid, gvid, math.atan2(dir.x, dir.z), gap))
	tip(string.format("Точка записана (%d): y=%.2f, расхождение лучей %.2f м", mat_n, pt[2], gap))
	ray1 = nil
end
local function log_mat()
	local act = db.actor
	local lvid, gvid = act:level_vertex_id(), act:game_vertex_id()
	local pos = level.vertex_position(lvid)
	local dir = act:direction()
	local ang = math.atan2(dir.x, dir.z)   -- radians, as the "angle" of a server object (rotation around Y)
	mat_n = mat_n + 1
	dbglog("%s", TAG .. string.format("MATTRESS %s: m%d = %.3f,%.3f,%.3f,%d,%d,%.3f", level.name(), mat_n, pos.x, pos.y, pos.z, lvid, gvid, ang))
	tip("Точка матраса записана в лог (" .. mat_n .. ")")
end

-- Runs an entry. Returns true when the window must be closed (the action needs the game to continue).
function run(tab, key)
	if not (db.actor and db.actor:alive()) then return false end
	if tab == "teleport" then
		return teleport(key)
	end
	if key == "ray1" then log_ray(true); return true
	elseif key == "ray2" then log_ray(false); return true
	elseif key == "mat" then log_mat(); return false
	elseif key == "diag" then diag(); return false
	elseif key == "pos" then log_pos(); return false
	elseif key == "h1" then change_time(1, "Время +1 ч"); return true
	elseif key == "h6" then change_time(6, "Время +6 ч"); return true
	elseif key == "d1" then change_time(24, "Время +1 сутки"); return true
	elseif key == "tf2" then
		local tf = math.min(level.get_time_factor() * 2, 1000)
		level.set_time_factor(tf)
		tip("Таймфактор " .. tf)
	elseif key == "tf1" then
		level.set_time_factor(tf_default)
		tip("Таймфактор " .. tf_default)
	elseif key == "heal" then
		local act = db.actor
		act.health = 0.99
		act.bleeding = 0.99
		act.power = 0.99
		act.psy_health = 0.99
		act.radiation = -1.0
		act:give_money(100000)
		tip("Здоровье восстановлено, +100000 руб.")
	elseif key == "surge" then
		tip(fp_surge.force(30, false)); return true
	elseif key == "eclipse" then
		tip(fp_surge.force(30, true)); return true
	end
	return false
end
