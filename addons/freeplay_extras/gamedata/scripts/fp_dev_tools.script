local function tip(text)
	news_manager.send_tip(db.actor, text)
end

-- list of a tab: array of { key, name, descr }
-- "teleport": two steps in one list. First the list of locations (levels that have guide points); "Execute" on a
-- location opens the list of its points (named the way guides name them), the first entry goes back to the locations.
-- «Телепорт»: два шага в одном списке. Сначала список локаций; «Выполнить» на локации открывает список её точек,
-- первая строка возвращает к локациям.
local tp_level = nil      -- system name of the opened location, nil = the list of locations
local tp_prefix = "lvl:"
local tp_back = "tp_back"

-- every guide point that exists in the current simulation, with the localized level name
local function teleport_points()
	local res = {}
	local cur = level.name()
	local smarts = sim_board.get_sim_board().smarts_by_names
	for name, d in pairs(guiders_table.teleport_points) do
		local smart = smarts[name]
		if smart then
			local ok, label = pcall(smart_names.get_smart_terrain_name, smart)
			if not ok or not label then label = name end
			res[#res + 1] = { key = name, label = label, level = d.level, lvl = game.translate_string(d.level), here = (d.level == cur) }
		end
	end
	return res
end

local function teleport_list()
	local pts = teleport_points()
	local res = {}
	if tp_level == nil then
		local levels, order = {}, {}
		for _, p in ipairs(pts) do
			local l = levels[p.level]
			if not l then
				l = { level = p.level, lvl = p.lvl, here = p.here, n = 0 }
				levels[p.level] = l
				order[#order + 1] = l
			end
			l.n = l.n + 1
		end
		table.sort(order, function(a, b)
			if a.here ~= b.here then return a.here end
			return a.lvl < b.lvl
		end)
		for _, l in ipairs(order) do
			res[#res + 1] = {
				key = tp_prefix .. l.level,
				name = l.lvl .. (l.here and " (вы здесь)" or "") .. ", точек: " .. l.n,
				descr = "Открыть список точек локации. Кнопка «Выполнить» показывает точки, прыжок будет по выбору точки.",
			}
		end
		return res
	end
	res[1] = { key = tp_back, name = "<< Назад к списку локаций", descr = "Вернуться к списку локаций." }
	local mine = {}
	for _, p in ipairs(pts) do
		if p.level == tp_level then
			mine[#mine + 1] = {
				key = p.key,
				name = p.label,
				descr = p.here and "Точка на этом уровне." or "Точка на другом уровне: сначала переход через зону перехода, как у проводников, затем прыжок к точке.",
			}
		end
	end
	table.sort(mine, function(a, b) return a.name < b.name end)
	for _, m in ipairs(mine) do res[#res + 1] = m end
	return res
end

-- the spawn menu calls it when a tab is opened: the teleport tab starts from the list of locations
function tab_opened(tab)
	if tab == "teleport" then tp_level = nil end
end

function list(tab)
	if tab == "tools" then return tools end
	if tab == "teleport" then return teleport_list() end
	return {}
end

function describe(tab, key)
	local t = list(tab)
	for i = 1, #t do
		if t[i].key == key then return t[i].descr end
	end
	return ""
end

-- The jump inside a level: a direct move onto the guide's patrol point.
-- To another level the guides' own way is used (guiders.action_teleport_to_point): the player is put onto the
-- patrol point guiders_table.cross_level_teleport[current][target], which lies inside a level changer zone, so the
-- engine itself loads the next level. On the new level the same guide jump goes to the exact point. The target is
-- kept in the savegame for that: "pending" (one string, empty when nothing is pending; the Lua state is rebuilt on
-- a level change, SRP's own guiders.save/load work the same way).
local pending = ""
local entry_time = 0
local started = 0
local ARRIVE_WAIT = 2000
local FAIL_WAIT = 8000
local mgr = nil

function attach(m)
	mgr = m
	m:subscribe({ script_name = "fp_dev_tools.on_net_spawn", signal = "on_net_spawn", fun = on_net_spawn })
	m:subscribe({ script_name = "fp_dev_tools.on_update", signal = "on_update", fun = on_update })
end

-- The target is kept as an info portion fp_tp_<index of the key in the sorted list of guide points> (savegame-safe: no
-- chunk of its own, so saves made by other versions keep loading).
local function keys()
	local t = {}
	for k in pairs(guiders_table.teleport_points) do t[#t + 1] = k end
	table.sort(t)
	return t
end

local function get_pending()
	local t = keys()
	for i = 1, math.min(#t, 128) do
		if has_alife_info("fp_tp_" .. (i - 1)) then return t[i], i - 1 end
	end
	return ""
end

local function set_pending(key)
	local t = keys()
	for i = 1, math.min(#t, 128) do
		local id = "fp_tp_" .. (i - 1)
		if t[i] == key then
			if not has_alife_info(id) then db.actor:give_info_portion(id) end
		elseif has_alife_info(id) then
			db.actor:disable_info_portion(id)
		end
	end
	pending = key
end

function on_net_spawn()
	entry_time = time_global()
	fp_log.always("%s", TAG .. "build " .. BUILD)
	pending = get_pending()
	if pending ~= "" then
		local d = guiders_table.teleport_points[pending]
		if not (d and d.level == level.name()) then set_pending("") end   -- stale target (the level change did not happen)
	end
end

-- Direct move, as in the first (working) version: set_actor_position at once, no effector chain that could
-- fail to come back while the tool window is closing. The fade is only cosmetic.
local function give_back_control()
	pcall(level.enable_input)
	pcall(level.show_indicators)
end

local function begin_jump(point, look, cross)
	if not level.patrol_path_exists(point) then
		tip("Нет точки пути: " .. tostring(point))
		fp_log.always("%s", TAG .. "patrol point missing: " .. tostring(point))
		return false
	end
	local act = db.actor
	local pnt = patrol(point)
	act:set_actor_position(pnt:point(0))
	if look and level.patrol_path_exists(look) then
		local dir = patrol(look):point(0):sub(pnt:point(0))
		act:set_actor_direction(-dir:getH())
	end
	pcall(level.add_pp_effector, "peace_unfade.ppe", 160608, false)
	if cross then started = time_global() end   -- waiting for the engine's level change
	fp_log.always("%s", TAG .. "moved to " .. point .. (cross and " (level changer)" or ""))
	return true
end

local function jump_to(key)
	local d = guiders_table.teleport_points[key]
	local point, look = d.point, d.look
	if not (point and look) then
		point, look = key .. "_kamp_1", key .. "_kamp_1_task"
	end
	return begin_jump(point, look, false)
end

function on_update(delta)
	mgr:reschedule(1000)
	if not (db.actor and db.actor:alive()) then return end
	if pending == "" then return end
	local key = pending
	local d = guiders_table.teleport_points[key]
	if not d then set_pending(""); return end
	if d.level == level.name() then
		if time_global() - entry_time < ARRIVE_WAIT then return end
		set_pending("")
		started = 0
		jump_to(key)
		fp_log.always("%s", TAG .. "arrived, second step to " .. key)
	elseif started > 0 and time_global() - started > FAIL_WAIT then
		-- the level did not change (level changer closed): give the control back
		set_pending("")
		started = 0
		give_back_control()
		tip("Переход закрыт (уровень не сменился)")
		fp_log.always("%s", TAG .. "level change failed for " .. key)
	end
end

local function teleport(key)
	local d = guiders_table.teleport_points[key]
	if not d then return false end
	local cur = level.name()
	if d.level == cur then
		if not jump_to(key) then return false end
	else
		local cross = guiders_table.cross_level_teleport[cur] and guiders_table.cross_level_teleport[cur][d.level]
		if not cross then
			tip("Нет перехода " .. cur .. " -> " .. d.level)
			return false
		end
		set_pending(key)
		started = 0
		if not begin_jump(cross, nil, true) then set_pending(""); return false end
	end
	fp_log.always("%s", TAG .. "teleport to " .. key .. " (" .. tostring(d.level) .. ")")
	return true
end

local function diag()
	local act = db.actor
	local p = act:position()
	local function inf(s) return s .. "=" .. tostring(has_alife_info(s)) end
	fp_log.always("%s", TAG .. "DIAG build " .. BUILD .. " level=" .. level.name() .. string.format(" pos=%.1f,%.1f,%.1f hour=%d", p.x, p.y, p.z, level.get_time_hours()))
	fp_log.always("%s", TAG .. "DIAG infos: " .. inf("srp_freeplay") .. " " .. inf("fp_sleep") .. " " .. inf("fp_stash") .. " " .. inf("fp_stash_done") .. " " .. inf("fp_stash_done2"))
	local zn = "mar_space_restrictor_csky_base_noweapon"
	local z = db.zone_by_name[zn]
	fp_log.always("%s", TAG .. "DIAG zone " .. zn .. " registered=" .. tostring(z ~= nil) .. " inside=" .. tostring(z ~= nil and z:inside(p)))
	local ok, a, b = pcall(function() return fp_sleep.is_enabled(), fp_sleep.in_place() end)
	fp_log.always("%s", TAG .. "DIAG sleep: " .. tostring(ok) .. " enabled=" .. tostring(a) .. " in_place=" .. tostring(b))
	local ok2, n = pcall(fp_sleep.mattress_count)
	fp_log.always("%s", TAG .. "DIAG mattresses (fp_mattress objects found): " .. tostring(ok2) .. " " .. tostring(n))
	fp_log.always("%s", TAG .. "DIAG sleeping_bag in inventory=" .. tostring(act:object("sleeping_bag") ~= nil))
	local old = alife():object("mar_physic_object_0039")
	fp_log.always("%s", TAG .. "DIAG decorative rucksack mar_physic_object_0039 exists=" .. tostring(old ~= nil))
	local n = 0
	for i = 0, 65534 do
		local se = alife():object(i, true)
		if se and (se:section_name() == "fp_base_stash" or se:section_name() == "fp_mattress") then
			n = n + 1
			local o = level.object_by_id(se.id)
			fp_log.always("%s", TAG .. "DIAG " .. se:section_name() .. " id=" .. se.id .. string.format(" pos=%.2f,%.2f,%.2f dist=%.1f lv=%s gv=%s", se.position.x, se.position.y, se.position.z, se.position:distance_to(p), tostring(se.m_level_vertex_id), tostring(se.m_game_vertex_id)) .. " online=" .. tostring(o ~= nil) .. (o and (" visual=" .. tostring(o:section())) or ""))
		end
	end
	fp_log.always("%s", TAG .. "DIAG fp_base_stash+fp_mattress count=" .. n)
	tip("Диагностика записана в лог")
end

local function change_time(h, text)
	local ok = pcall(level.change_game_time, 0, h, 0)
	tip(ok and text or "level.change_game_time недоступна в этом движке")
end

local function log_pos()
	local act = db.actor
	local lvid, gvid = act:level_vertex_id(), act:game_vertex_id()
	local pos = level.vertex_position(lvid)
	local dir = act:direction()
	local msg = string.format("%s pos=vector():set(%.3f,%.3f,%.3f), lvid=%d, gvid=%d, dir=vector():set(%.3f,%.3f,%.3f)",
		level.name(), pos.x, pos.y, pos.z, lvid, gvid, dir.x, dir.y, dir.z)
	fp_log.always("%s", TAG .. msg)
	tip("Координаты записаны в лог")
end

-- A line for the coords table of ogsm_bring_items: stand where a corpse with items should lie and press the button.
-- Строка для таблицы coords в ogsm_bring_items: встаньте, где должен лежать труп, и нажмите кнопку.
local function log_spot()
	local act = db.actor
	local p = act:position()
	local short = string.gsub(level.name(), "^l%d+%a*_", "")
	local msg = string.format('SPOT\t{vector():set(%.6f,%.6f,%.6f), %d, %d, "%s"},', p.x, p.y, p.z, act:level_vertex_id(), act:game_vertex_id(), short)
	fp_log.always("%s", TAG .. msg)
	tip("Точка записана в лог (строка SPOT)")
end

-- Size estimate of the actor's pstor as xr_logic.pstor_save_all writes it: u32 count, then per entry key (len+1),
-- type byte, value (number 4, boolean 1, string len+1). The chunk limit comes from the engine (see README).
-- Оценка размера pstor актора по формате xr_logic.pstor_save_all; предел чанка задаёт движок (см. README).
local STORE_LIMIT = 6 * 1024
local function log_store()
	local st = db.storage and db.storage[db.actor:id()]
	local ps = st and st.pstor
	if not ps then tip("pstor пуст или недоступен") return end
	local total, count, rows = 4, 0, {}
	for k, v in pairs(ps) do
		local tv = type(v)
		local sz = string.len(tostring(k)) + 1 + 1
		if tv == "string" then sz = sz + string.len(v) + 1
		elseif tv == "boolean" then sz = sz + 1
		else sz = sz + 4 end
		total = total + sz
		count = count + 1
		rows[#rows + 1] = { k = tostring(k), sz = sz }
	end
	table.sort(rows, function(a, b) return a.sz > b.sz end)
	fp_log.always("%s", TAG .. string.format("STORE pstor: %d entries, ~%d bytes of %d (%.1f%%)", count, total, STORE_LIMIT, total * 100 / STORE_LIMIT))
	for i = 1, math.min(10, #rows) do
		fp_log.always("%s", TAG .. string.format("STORE %2d. %s: %d bytes", i, rows[i].k, rows[i].sz))
	end
	tip(string.format("pstor: %d записей, ~%d байт (%.1f%% от ~6 КБ)", count, total, total * 100 / STORE_LIMIT))
end

-- Jump forward by m metres along the view direction (horizontal). Height: the nearest AI-net vertex, if it is close,
-- otherwise the actor's height + 1 m. Прыжок вперёд на m метров по направлению взгляда; высота по ближайшей вершине AI-сетки.
local function jump_forward(m)
	local act = db.actor
	local d, p = act:direction(), act:position()
	local len = math.sqrt(d.x * d.x + d.z * d.z)
	if len < 0.01 then tip("Смотрите не строго вверх или вниз") return end
	local tx, tz = p.x + d.x / len * m, p.z + d.z / len * m
	local y = p.y + 1.0
	local ok, vid = pcall(level.vertex_id, vector():set(tx, p.y, tz))
	if ok and vid then
		local vp = level.vertex_position(vid)
		if (vp.x - tx) * (vp.x - tx) + (vp.z - tz) * (vp.z - tz) <= 25 then y = vp.y + 0.3 end
	end
	act:set_actor_position(vector():set(tx, y, tz))
	fp_log.always("%s", TAG .. string.format("JUMP %d m: %.1f,%.1f,%.1f -> %.1f,%.1f,%.1f (ai-net %s)", m, p.x, p.y, p.z, tx, y, tz, tostring(ok and vid or "none")))
	tip("Вперёд на " .. m .. " м")
end

local function change_money(sign, n)
	n = math.floor(math.min(math.max(n or 10000, 1), 10000000))
	local act = db.actor
	if sign < 0 then n = math.min(n, act:money()) end
	if n <= 0 then tip("Денег нет") return end
	act:give_money(sign * n)
	tip((sign > 0 and "Деньги +" or "Деньги -") .. n)
end

local mat_n = 0
local ray1 = nil

-- two camera rays at the same spot give its position in space (the engine export of this build has no ray cast)
local function cam_ray()
	local d = device()
	local p, v = d.cam_pos, d.cam_dir
	return { px = p.x, py = p.y, pz = p.z, dx = v.x, dy = v.y, dz = v.z }
end

local function ray_point(r1, r2)
	local wx, wy, wz = r1.px - r2.px, r1.py - r2.py, r1.pz - r2.pz
	local b = r1.dx * r2.dx + r1.dy * r2.dy + r1.dz * r2.dz
	local d = r1.dx * wx + r1.dy * wy + r1.dz * wz
	local e = r2.dx * wx + r2.dy * wy + r2.dz * wz
	local den = 1 - b * b
	if den < 0.02 then return nil, "лучи почти параллельны: отойдите в сторону на 2-3 м" end
	local s = (b * e - d) / den
	local u = (e - b * d) / den
	local q1 = { r1.px + r1.dx * s, r1.py + r1.dy * s, r1.pz + r1.dz * s }
	local q2 = { r2.px + r2.dx * u, r2.py + r2.dy * u, r2.pz + r2.dz * u }
	local gap = math.sqrt((q1[1] - q2[1]) ^ 2 + (q1[2] - q2[2]) ^ 2 + (q1[3] - q2[3]) ^ 2)
	if s < 0 or u < 0 then return nil, "точка позади камеры: наведите на одну и ту же точку" end
	return { (q1[1] + q2[1]) / 2, (q1[2] + q2[2]) / 2, (q1[3] + q2[3]) / 2 }, gap
end

local function log_ray(first)
	if first then
		ray1 = cam_ray()
		tip("Луч 1 запомнен. Отойдите в сторону и наведите на ту же точку")
		return
	end
	if not ray1 then tip("Сначала «луч 1»"); return end
	local pt, gap = ray_point(ray1, cam_ray())
	if not pt then tip(gap); return end
	local act = db.actor
	local lvid = level.vertex_id(vector():set(pt[1], pt[2], pt[3]))
	local gvid = act:game_vertex_id()
	local dir = act:direction()
	mat_n = mat_n + 1
	fp_log.always("%s", TAG .. string.format("MATTRESS %s: m%d = %.3f,%.3f,%.3f,%d,%d,%.3f   ; rays gap %.2f m", level.name(), mat_n, pt[1], pt[2], pt[3], lvid, gvid, math.atan2(dir.x, dir.z), gap))
	tip(string.format("Точка записана (%d): y=%.2f, расхождение лучей %.2f м", mat_n, pt[2], gap))
	ray1 = nil
end
local function log_mat()
	local act = db.actor
	local lvid, gvid = act:level_vertex_id(), act:game_vertex_id()
	local pos = level.vertex_position(lvid)
	local dir = act:direction()
	local ang = math.atan2(dir.x, dir.z)   -- radians, as the "angle" of a server object (rotation around Y)
	mat_n = mat_n + 1
	fp_log.always("%s", TAG .. string.format("MATTRESS %s: m%d = %.3f,%.3f,%.3f,%d,%d,%.3f", level.name(), mat_n, pos.x, pos.y, pos.z, lvid, gvid, ang))
	tip("Точка матраса записана в лог (" .. mat_n .. ")")
end

-- "To mattress N": point N of [mattress_<level>] of misc\fp_sleep.ltx (the same points fp_sleep turns into objects).
local function goto_bed(n)
	local sect = "mattress_" .. level.name()
	local ini = ini_file("misc\\fp_sleep.ltx")
	if not ini:section_exist(sect) or n > ini:line_count(sect) then
		tip("Точки " .. n .. " нет на этом уровне (" .. level.name() .. ")")
		return false
	end
	local _, name, v = ini:r_line(sect, n - 1, "", "")
	local x, y, z = string.match(v, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
	x, y, z = tonumber(x), tonumber(y), tonumber(z)
	db.actor:set_actor_position(vector():set(x, y + 0.3, z))
	fp_log.always("%s", TAG .. string.format("BEDCHECK %d %s = %.3f,%.3f,%.3f", n, name, x, y, z))
	tip(string.format("Точка %d (%s): %.1f, %.1f, %.1f", n, name, x, y, z))
	return true
end

-- "To the PDA corpse": the corpse of the active find_pda task (ogsm_rt_manager) and what is lying inside it.
local function goto_pda_corpse()
	local mgr = ogsm_rt_manager.get_rt_manager()
	local found = false
	for _, id in pairs(mgr.task_id_by_type["find_pda"] or {}) do
		local td = mgr.task_info[id]
		local corpse = td.selected_corpse and alife():object(td.selected_corpse)
		if corpse then
			found = true
			local lid = game_graph():vertex(corpse.m_game_vertex_id):level_id()
			local same = lid == alife():level_id()
			local ok, nm = pcall(alife().level_name, alife(), lid)
			local lvl = same and level.name() or (ok and nm) or ("уровень №" .. lid)
			local pda = td.selected_target and alife():object(td.selected_target)
			fp_log.always("%s", TAG .. string.format("PDACORPSE %s: corpse %d on %s at %.1f,%.1f,%.1f, pda %s parent %s", id, corpse.id, lvl, corpse.position.x, corpse.position.y, corpse.position.z, tostring(td.selected_target), pda and tostring(pda.parent_id) or "NONE"))
			if lvl == level.name() then
				db.actor:set_actor_position(vector():set(corpse.position.x, corpse.position.y + 0.5, corpse.position.z))
				tip("Труп КПК: " .. lvl .. ", КПК " .. (pda and ("в объекте " .. pda.parent_id) or "ОТСУТСТВУЕТ"))
			else
				tip("Труп КПК на уровне " .. lvl .. " (вы на " .. level.name() .. ")")
			end
		end
	end
	if not found then tip("Трупа КПК нет: возьмите задание и дойдите до его уровня") end
	return found
end

-- Where a corpse lies: level name (current level by name, another one by the engine's name or number), same-level flag.
local function where(game_vertex_id)
	local lid = game_graph():vertex(game_vertex_id):level_id()
	local same = lid == alife():level_id()
	local ok, nm = pcall(alife().level_name, alife(), lid)
	return same and level.name() or (ok and nm) or ("уровень №" .. lid), same
end

local function flash_list()
	local list = ogsm_bring_items.flash_holders()
	for i, h in ipairs(list) do
		local sobj = alife():object(h.id)
		local lvl = sobj and where(sobj.m_game_vertex_id) or "?"
		fp_log.always("%s", TAG .. string.format("FLASH %d %s: corpse %d on %s at %.1f,%.1f,%.1f", i, h.section, h.id, lvl, h.pos.x, h.pos.y, h.pos.z))
	end
	tip("Предметов в трупах: " .. #list .. " (подробности в логе, строки FLASH)")
	return list
end

local flash_idx = 0
local function goto_flash(step)
	local list = ogsm_bring_items.flash_holders()
	if #list == 0 then tip("Предметов в трупах не найдено") return false end
	flash_idx = (flash_idx + step - 1) % #list + 1
	local n = flash_idx
	local h = list[n]
	local sobj = alife():object(h.id)
	local lvl, same = where(sobj.m_game_vertex_id)
	fp_log.always("%s", TAG .. string.format("FLASH %d %s: corpse %d on %s at %.1f,%.1f,%.1f", n, h.section, h.id, lvl, h.pos.x, h.pos.y, h.pos.z))
	if not same then
		tip(string.format("№%d из %d, %s: труп на уровне %s, вы на %s", n, #list, h.section, lvl, level.name()))
		return false
	end
	db.actor:set_actor_position(vector():set(h.pos.x, h.pos.y + 0.5, h.pos.z))
	tip(string.format("№%d из %d, %s: труп на этом уровне (%s)", n, #list, h.section, lvl))
	return true
end

-- Runs an entry. Returns true when the window must be closed (the action needs the game to continue).
-- n: number from the spawn menu text field or nil
function run(tab, key, n)
	if not (db.actor and db.actor:alive()) then return false end
	if tab == "teleport" then
		if key == tp_back then tp_level = nil return "refresh" end
		local lv = string.match(key, "^" .. tp_prefix .. "(.+)$")
		if lv then tp_level = lv return "refresh" end
		return teleport(key)
	end
	local bed = string.match(key, "^bed(%d+)$")
	if bed then return goto_bed(tonumber(bed)) end
	if key == "pdacorpse" then return goto_pda_corpse() end
	local fwd = string.match(key, "^fwd(%d+)$")
	if fwd then jump_forward(tonumber(fwd)) return true end
	if key == "fwdn" then jump_forward(math.floor(math.min(math.max(n or 10, 1), 500))) return true end
	if key == "money" then change_money(1, n) return false end
	if key == "moneyminus" then change_money(-1, n) return false end
	if key == "flashlist" then flash_list() return false end
	if key == "flashnext" then return goto_flash(1) end
	if key == "flashprev" then return goto_flash(-1) end
	if key == "wpn" then pcall(db.actor.restore_weapon, db.actor) tip("restore_weapon вызван") return true end
	if key == "mats" then
		local ok, a, b = pcall(fp_sleep.recreate_mattresses)
		tip(ok and ("Матрасы: удалено " .. a .. ", создано " .. b) or "Ошибка пересоздания, см. лог")
		return true
	end
	if key == "ray1" then log_ray(true); return true
	elseif key == "ray2" then log_ray(false); return true
	elseif key == "mat" then log_mat(); return false
	elseif key == "diag" then diag(); return false
	elseif key == "pos" then log_pos(); return false
	elseif key == "spot" then log_spot(); return false
	elseif key == "store" then log_store(); return false
	elseif key == "h1" then change_time(1, "Время +1 ч"); return true
	elseif key == "h6" then change_time(6, "Время +6 ч"); return true
	elseif key == "d1" then change_time(24, "Время +1 сутки"); return true
	elseif string.match(key, "^tf%d+$") or key == "tfn" then
		-- N x the standard speed (tf_default); x1 restores the standard course of time
		-- N x стандартная скорость (tf_default); x1 возвращает стандартный ход времени
		local mult = key == "tfn" and (n or 1) or tonumber(string.match(key, "%d+"))
		mult = math.floor(math.min(math.max(mult, 1), 100))
		local tf = math.min(tf_default * mult, 1000)
		level.set_time_factor(tf)
		tip("Время x" .. mult .. " (таймфактор " .. tf .. ")")
	elseif key == "heal" then
		local act = db.actor
		act.health = 0.99
		act.bleeding = 0.99
		act.power = 0.99
		act.psy_health = 0.99
		act.radiation = -1.0
		act:give_money(100000)
		tip("Здоровье восстановлено, +100000 руб.")
	elseif key == "surge" then
		tip(fp_surge.force(30, false)); return true
	elseif key == "eclipse" then
		tip(fp_surge.force(30, true)); return true
	end
	return false
end
