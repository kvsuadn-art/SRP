-- documents and what the buyers pay for one (original OGSM prices)
local doc_price = {
	doc_1 = 3000,
	doc_2 = 3000,
	doc_3 = 3300,
	doc_4 = 3000,
	doc_5 = 3000,
	doc_6 = 3000,
	doc_7 = 3000,
	doc_8 = 3000,
	doc_9 = 3000,
	doc_10 = 3000,
	doc_11 = 3000,
	doc_12 = 3000,
	doc_13 = 3000,
	doc_14 = 3000,
	doc_15 = 3000
}
local doc_list = {"doc_1", "doc_2", "doc_3", "doc_4", "doc_5", "doc_6", "doc_7", "doc_8", "doc_9", "doc_10", "doc_11", "doc_12", "doc_13", "doc_14", "doc_15"}

-- flash drives are read from misc\fp_loot.ltx [flashes] so the list can be tuned without code changes
local function read_flashes()
	local list = {}
	local ini = ini_file("misc\\fp_loot.ltx")
	if ini:section_exist("flashes") then
		for i = 0, ini:line_count("flashes") - 1 do
			local result, section = ini:r_line("flashes", i, "", "")
			table.insert(list, section)
		end
	end
	return list
end

-- called once per game (see freeplay_mode.prepare_world)
function startup_spawn()
	if has_alife_info(INFO_SPAWNED) then
		return
	end
	db.actor:give_info_portion(INFO_SPAWNED)

	local sim = alife()
	if not sim then
		return
	end

	local free = {}
	for i = 1, #coords do
		free[i] = i
	end

	local function place(section)
		if #free == 0 then
			return
		end
		local k = math.random(#free)
		local c = coords[free[k]]
		table.remove(free, k)
		sim:create(section, c[1], c[2], c[3])
	end

	for _, section in ipairs(read_flashes()) do
		place(section)
	end
	for _, section in ipairs(doc_list) do
		place(section)
	end
end

-- documents in the actor's inventory (dialog precondition)
function check_documents()
	local actor = db.actor
	for _, section in ipairs(doc_list) do
		if actor:object(section) ~= nil then
			return true
		end
	end
	return false
end

-- sell all documents to the speaker (dialog action)
function relocate_documents(first_speaker, second_speaker)
	local actor = db.actor
	local total = 0
	for _, section in ipairs(doc_list) do
		if actor:object(section) ~= nil then
			dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, section)
			total = total + doc_price[section]
		end
	end
	if total > 0 then
		dialogs.relocate_money(first_speaker, total, "in")
	end
end
