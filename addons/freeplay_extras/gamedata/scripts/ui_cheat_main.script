-- Adaptation for SRP Freeplay: Eon (see addons/freeplay_extras/README.md: no global patches, no cache file, no main-menu substitution)-----------------------------------------------------------------------------------------------
local log = function(fmt, ...)
	dbglog("%s", string.format(fmt, ...))
end

local sys_ini = system_ini()
cheat_list = nil

gameIsOn = false
local file = nil

local dlg = nil

-- owner: the main menu (opened from the menu, F1) or nil (opened in game, from the console item)
-- tab: optional id of the tab to open ("tools", "teleport", ...)
function start_menu(owner, tab)
	gameIsOn = (level.present() and db.actor and db.actor:alive())
	if cheat_list == nil then
		cheat_list = {}
		local tmp = collect_sections.main()
		local total = 0
		for k,v in pairs(tmp) do total = total + #v end
		if total == 0 then
			-- Freeplay: stub instead of an empty window (the scan found nothing, spawn_list.ltx was not made)
			cheat_list = nil
			local msg = "Спавн-меню: список секций пуст (см. лог: collect_sections). Если configs\\spawn_list.ltx уже есть - удалите его и откройте меню снова."
			dbglog("%s", msg)
			if db.actor then news_manager.send_tip(db.actor, msg) end
			return
		end
		local t
		for k,v in pairs(tmp) do
			cheat_list[k] = {}
			t = cheat_list[k]
			for i,s in pairs(v) do
				t[#t+1] = {
					section = s,
					name = game.translate_string(fp_dev_util.r_string_ex(sys_ini, s, "inv_name", s))
				}
			end
			table.sort(t, sort_main)
		end
	end
	if dlg == nil then
		dlg = ui_cheat_cs.cheat_menu()
	end
	dlg.owner = owner
	if tab then dlg.tab:SetActiveTab(tab) end
	if owner then
		owner:GetHolder():start_stop_menu(dlg, true)
		owner:GetHolder():start_stop_menu(owner, true)
		owner:Show(false)
	else
		level.start_stop_menu(dlg, true)
	end
end

-- Сортируем предметы по алфавиту: чтоб было проще искать нужное
-- Сортируем предметы по алфавиту: чтоб было проще искать нужное
function sort_main(s1,s2)
	local sname = sort_by_name(s1.name, s2.name)
	if sname ~= nil then return sname end
	return sort_by_section(s1.section, s2.section)
end

function sort_by_name(n1, n2)
	n1 = fp_dev_util.lower1(n1)
	n2 = fp_dev_util.lower1(n2)
	local cnt = math.min(#n1, #n2)
	local l1, l2
	for a=1,cnt do
		l1 = n1:sub(a,a):byte()
		l2 = n2:sub(a,a):byte()
		if l1~=l2 then return l1<l2 end
	end
	return nil
end
	
function sort_by_section(s1, s2)
	local cnt = math.min(#s1, #s2)
	local l1, l2
	for a=1,cnt do
		l1 = s1:sub(a,a):byte()
		l2 = s2:sub(a,a):byte()
		if l1~=l2 then return l1<l2 end
	end
	return #s1<#s2
end

function give_item_icon(section)
	local t = {}
	t.width = fp_dev_util.r_u32_ex(sys_ini, section, "inv_grid_width", 1) *50
	t.height = fp_dev_util.r_u32_ex(sys_ini, section, "inv_grid_height", 1) *50
	t.x = fp_dev_util.r_u32_ex(sys_ini, section, "inv_grid_x", 8) *50
	t.y = fp_dev_util.r_u32_ex(sys_ini, section, "inv_grid_y", 13) *50
	return t
end

function give_monster_icon(section)
	local t = {}
	local texture = fp_dev_util.r_string_ex(sys_ini, section, "icon", "ui_npc_monster_mutant_boar")
	
	local tex_info = GetTextureInfo(texture, texture)
	local rect = tex_info:get_rect()
	t.x = rect.x1
	t.y = rect.y1
	t.width = rect.x2 - rect.x1
	t.height = rect.y2 - rect.y1
	return t, tex_info:get_file_name()
end

function spawn_item(section, num)
	if not section then return end
	if gameIsOn then
		if num==nil then num = 1 end
		for i=1,num do
			alife():create(section,vector(),0,0,0)
		end
		local snd = sound_object([[detectors\contact_1]])
		snd:play(db.actor, 0, sound_object.s2d)
	end
end

function spawn_npc(section, num)
	if not section then return end
	if gameIsOn then
		if num==nil then num = 1 end
		local act = db.actor
		for i=1,num do
			alife():create(section, act:position():add(act:direction():mul(4)), act:level_vertex_id(), act:game_vertex_id())
		end
		local snd = sound_object([[detectors\contact_1]])
		snd:play(act, 0, sound_object.s2d)
	end
end
