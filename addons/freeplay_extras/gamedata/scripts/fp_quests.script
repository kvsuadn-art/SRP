-- fp_quests: compact quest layer for quests ported from SGM (Sigerous Mod 3.10, GeJorge) ideas.
-- Adaptation SRP Freeplay: Eon
--
-- Not a port of the SGM task layer: quests are re-implemented on stock engine tasks (CGameTask, as in
-- ogsm_rt_manager) and dialogs; data is in misc\fp_quests.ltx. Quest types:
--   fetch   - a quest item is spawned at a place, the actor brings it to the giver for a reward;
--   capture - a smart terrain held by the enemy faction must stop belonging to it (checked every 5 s,
--             only while such a quest is active), then report to the giver;
--   kill    - an NPC (section 'npc') is spawned at 'spawn' when the quest starts; its death completes
--             the quest (checked every 5 s while the quest is active), then report to the giver;
--   bonus   - no task: a dialog reward available once all quests in 'requires' are rewarded.
-- Optional 'faction' in a quest (stalker/csky): the actor must have joined it (also in Freeplay).
-- The module switches itself on (info fp_quests) at the first update: quests are an extension of both modes.
-- Dialog ids: <quest>_give (start), <quest>_complete (hand over). Stage flags are info portions:
-- <quest>_start, <quest>_complete (item found), <quest>_reward (finished) - same names as in SGM.
-- Switch: info srp_freeplay or fp_quests. Savegame: u8 count; per started quest: name + u16 item id.

local TAG = "[fp_quests] "
local ini = ini_file("misc\\fp_quests.ltx")
local mgr = nil
local data = {}    -- quest -> parsed config
local items = {}   -- quest -> server id of the spawned quest item

function is_enabled()
	return has_alife_info("srp_freeplay") or has_alife_info("fp_quests")
end

local function cfg(q)
	local c = data[q]
	if c ~= nil then return c end
	if not ini:section_exist(q) then return nil end
	c = {}
	c.type = ini:line_exist(q, "type") and ini:r_string(q, "type") or "fetch"
	c.giver = ini:r_string(q, "giver")
	c.faction = ini:line_exist(q, "faction") and ini:r_string(q, "faction") or nil
	if c.type == "bonus" then
		c.requires = {}
		for s in string.gmatch(ini:r_string(q, "requires"), "[^,%s]+") do c.requires[#c.requires + 1] = s end
	end
	if c.type == "capture" then
		c.smart = ini:r_string(q, "smart")
		c.enemy = ini:r_string(q, "enemy")
	elseif c.type == "fetch" or c.type == "kill" then
		if c.type == "fetch" then c.item = ini:r_string(q, "item") else c.npc = ini:r_string(q, "npc") end
		local pos = ini:r_string(q, "spawn")
		local x, y, z, lv, gv = string.match(pos, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*(%d+)%s*,%s*(%d+)")
		c.pos = vector():set(tonumber(x), tonumber(y), tonumber(z))
		c.lv, c.gv = tonumber(lv), tonumber(gv)
	end
	c.money = ini:line_exist(q, "reward_money") and ini:r_u32(q, "reward_money") or 0
	c.rewards = {}
	if ini:line_exist(q, "reward_items") then
		for s in string.gmatch(ini:r_string(q, "reward_items"), "[^,%s]+") do c.rewards[#c.rewards + 1] = s end
	end
	data[q] = c
	return c
end

local smart_held

-- a quest with 'faction' is only for an actor who has joined that faction (in any mode)
local function gate(c)
	return c.faction == nil or db.actor:character_community() == "actor_" .. c.faction
end

-- generic dialog precondition of a quest: mode switch, faction, quest state
local function available(q)
	if not is_enabled() then return false end
	local c = cfg(q)
	if c == nil or not gate(c) then return false end
	if c.type == "capture" then return smart_held(q) end
	if c.type == "bonus" then
		for _, r in ipairs(c.requires) do
			if not has_alife_info(r .. "_reward") then return false end
		end
	end
	return true
end

local function quest_of(dialog_id)
	return (string.gsub(dialog_id, "_[a-z]+$", ""))
end

local function giver_id(c)
	local s = alife():object(c.giver)
	return s and s.id or nil
end

local function smart_id(c)
	if c.smart == nil then return nil end
	local board = sim_board.get_sim_board()
	local sm = board and board.smarts_by_names[c.smart]
	return sm and sm.id or nil
end

local function task_id(q) return "fpq_" .. q end

local function set_task_stage(q, back)
	local task = db.actor:get_task(task_id(q), true)
	if task == nil then return end
	local c = cfg(q)
	if back then
		task:set_title(game.translate_string(q .. "_back"))
		task:set_description(game.translate_string(q .. "_back_text"))
		local gid = giver_id(c)
		if gid then task:change_map_location("secondary_task_location", gid) end
	else
		task:set_title(game.translate_string(q))
		task:set_description(game.translate_string(q .. "_text"))
	end
end

local function give_task(q)
	local c = cfg(q)
	local task = CGameTask()
	task:set_id(task_id(q))
	task:set_title(game.translate_string(q))
	task:set_description(game.translate_string(q .. "_text"))
	task:set_icon_name("ui_pda2_mtask_overlay")
	task:set_type(1)
	task:add_complete_func("fp_quests.task_complete")
	task:set_map_hint(q)
	task:set_map_location("secondary_task_location")
	task:set_map_object_id(items[q] or smart_id(c) or giver_id(c) or 0)
	db.actor:give_task(task, 0, false)
	if has_alife_info(q .. "_complete") then set_task_stage(q, true) end
end

-- engine polls this: true = task is completed
function task_complete(id)
	local q = string.sub(id, 5)
	return has_alife_info(q .. "_reward")
end

-------------------------------------------------------------- dialog actions
function start(actor, npc, dialog_id, phrase_id)
	local q = quest_of(dialog_id)
	local c = cfg(q)
	if c == nil then printf(TAG .. "no config for '%s'", tostring(q)) return end
	if (c.type == "fetch" or c.type == "kill") and items[q] == nil then
		local se = alife():create(c.item or c.npc, c.pos, c.lv, c.gv)
		items[q] = se and se.id or nil
	end
	db.actor:give_info_portion(q .. "_start")
	give_task(q)
end

function has_item(q)
	local c = cfg(q)
	return c ~= nil and db.actor:object(c.item) ~= nil
end

function finish(actor, npc, dialog_id, phrase_id)
	local q = quest_of(dialog_id)
	local c = cfg(q)
	if c == nil then return end
	if c.item ~= nil then dialogs.relocate_item_section_from_actor(actor, npc, c.item) end
	if c.money > 0 then dialogs.relocate_money(npc, c.money, "in") end
	for _, s in ipairs(c.rewards) do dialogs.relocate_item_section_to_actor(actor, npc, s, 1) end
	db.actor:give_info_portion(q .. "_reward")
	items[q] = nil
end

-- capture quests: precondition for the "give" dialog (the enemy still holds the smart)
smart_held = function(q)
	local c = cfg(q)
	if c == nil then return false end
	local board = sim_board.get_sim_board()
	local sm = board and board.smarts_by_names[c.smart]
	return sm ~= nil and sm.player_name == c.enemy
end

-- per-quest dialog preconditions (a dialog-level precondition gets no dialog id)
function has_esc_shilov_find_rukzak_item() return has_item("esc_shilov_find_rukzak") end
function esc_capture_army_blockpost_available() return available("esc_capture_army_blockpost") end
function mar_csky_kill_baron_available() return available("mar_csky_kill_baron") end
function esc_shilov_find_rukzak_available() return available("esc_shilov_find_rukzak") end
function mar_capture_pumping_station_available() return available("mar_capture_pumping_station") end
function mar_capture_church_available() return available("mar_capture_church") end
function mar_capture_boat_station_available() return available("mar_capture_boat_station") end
function mar_capture_embankment_available() return available("mar_capture_embankment") end
function mar_capture_north_khutor_available() return available("mar_capture_north_khutor") end
function mar_last_intensify_reward_available() return available("mar_last_intensify_reward") end

-------------------------------------------------------------- signals
function attach(m)
	mgr = m
	m:subscribe({ signal = "on_update", fun = fp_on_update })
	m:subscribe({ signal = "on_item_take", fun = fp_on_item_take })
	m:subscribe({ signal = "on_save", fun = fp_on_save })
	m:subscribe({ signal = "on_load", fun = fp_on_load })
end

-- capture/kill quests: the list is read from the config, the state is in info portions (kill: target id in the save)
local function target_gone(q)
	local id = items[q]
	if id == nil then return true end
	local se = alife():object(id)
	return se == nil or not se:alive()
end

local capture_list = nil
function fp_on_update(delta)
	if mgr then mgr:reschedule(5000) end
	if db.actor == nil then return end
	if not has_alife_info("fp_quests") then db.actor:give_info_portion("fp_quests") end
	if capture_list == nil then
		capture_list = {}
		for i = 0, ini:line_count("quests") - 1 do
			local _, q = ini:r_line("quests", i, "", "")
			local c = cfg(q)
			if c ~= nil and (c.type == "capture" or c.type == "kill") then capture_list[#capture_list + 1] = q end
		end
	end
	for _, q in ipairs(capture_list) do
		if has_alife_info(q .. "_start") and not has_alife_info(q .. "_complete") then
			local c = cfg(q)
			local done
			if c.type == "kill" then done = target_gone(q) else done = not smart_held(q) end
			if done then
				db.actor:give_info_portion(q .. "_complete")
				set_task_stage(q, true)
			end
		end
	end
end

function fp_on_item_take(obj)
	if not is_enabled() then return end
	local sect = obj:section()
	for q in pairs(items) do
		local c = cfg(q)
		if c ~= nil and c.item == sect and obj:id() == items[q] and not has_alife_info(q .. "_complete") then
			db.actor:give_info_portion(q .. "_complete")
			set_task_stage(q, true)
		end
	end
end

function fp_on_save(packet)
	local list = {}
	for q, id in pairs(items) do list[#list + 1] = q end
	packet:w_u8(#list)
	for _, q in ipairs(list) do
		packet:w_stringZ(q)
		packet:w_u16(items[q])
	end
end

function fp_on_load(reader)
	local n = reader:r_u8()
	for _ = 1, n do
		local q = reader:r_stringZ()
		items[q] = reader:r_u16()
	end
end
