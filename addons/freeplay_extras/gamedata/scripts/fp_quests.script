-- fp_quests: compact quest layer for quests ported from SGM (Sigerous Mod 3.10, GeJorge) ideas.
-- Адаптация под SRP Freeplay: Eon
--
-- Not a port of the SGM task layer: quests are re-implemented on stock engine tasks (CGameTask, as in
-- ogsm_rt_manager) and dialogs; data is in misc\fp_quests.ltx. Quest types:
--   fetch   - a quest item is spawned at a place, the actor brings it to the giver for a reward;
--   capture - a smart terrain held by the enemy faction must stop belonging to it (checked every 2 s,
--             only while such a quest is active), then report to the giver;
--   kill    - an NPC (section 'npc') is spawned at 'spawn' when the quest starts; its death completes
--             the quest (checked every 2 s while the quest is active), then report to the giver;
--             optional loot (an item the actor must also take from the targets before it counts), optional count (NPCs per wave) and waves (the next wave appears when the previous is dead);
--   talk    - an NPC (section 'npc') is spawned at 'spawn'; talking to it (a dialog action fp_quests.talked)
--             completes the quest, then report to the giver;
--   deliver - the actor brings an existing item (section 'item', nothing is spawned); it is noticed in the
--             inventory every 2 s while the quest is active, then report to the giver;
--   bonus   - no task: a dialog reward available once all quests in 'requires' are rewarded.
-- 'giver = profile:<name>': the giver is an NPC without a fixed object name, its id is stored at the start.
-- Optional 'story_info': outside Freeplay the quest opens after this original story info portion.
-- Optional 'faction' in a quest (stalker/csky): the actor must have joined it (also in Freeplay).
-- The module switches itself on (info fp_quests) at the first update: quests are an extension of both modes.
-- Dialog ids: <quest>_give (start), <quest>_complete (hand over). Stage flags are info portions:
-- <quest>_start, <quest>_complete (item found), <quest>_reward (finished) - same names as in SGM.
-- Switch: info srp_freeplay or fp_quests. Savegame: u8 count; per started quest: name + u16 item id.

local TAG = "[fp_quests] "
local ini = ini_file("misc\\fp_quests.ltx")
local mgr = nil
local data = {}    -- quest -> parsed config
local spawn_list = nil
local givers = {}  -- quest -> server id of the giver NPC, kept only for quests with giver = profile:<name>
local items = {}   -- quest -> list of server ids (fetch: the quest item, kill: the targets of the current wave)

function is_enabled()
	return has_alife_info("srp_freeplay") or has_alife_info("fp_quests")
end

local function cfg(q)
	local c = data[q]
	if c ~= nil then return c end
	if not ini:section_exist(q) then return nil end
	c = {}
	c.type = ini:line_exist(q, "type") and ini:r_string(q, "type") or "fetch"
	c.giver = ini:r_string(q, "giver")
	c.faction = ini:line_exist(q, "faction") and ini:r_string(q, "faction") or nil
	-- 'giver = spawn:<section>': a new NPC created once at 'giver_pos' (x,y,z,lv,gv); its id is kept in items["giver.<section>"]
	c.giver_spawn = string.match(c.giver, "^spawn:(.+)$")
	if c.giver_spawn then
		local x, y, z, lv, gv = string.match(ini:r_string(q, "giver_pos"), "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*(%d+)%s*,%s*(%d+)")
		c.giver_at = vector():set(tonumber(x), tonumber(y), tonumber(z))
		c.giver_lv, c.giver_gv = tonumber(lv), tonumber(gv)
		-- 'replaces': the story NPC this giver stands in for; he is removed from the world in Freeplay
		c.replaces = ini:line_exist(q, "replaces") and ini:r_string(q, "replaces") or nil
	end
	-- 'lend' = a weapon given at the start if the actor has none of 'lend_skip' (comma list) and taken back at the reward; 'lend_ammo' goes along
	if ini:line_exist(q, "lend") then
		c.lend = ini:r_string(q, "lend")
		c.lend_ammo = ini:line_exist(q, "lend_ammo") and ini:r_string(q, "lend_ammo") or nil
		c.lend_skip = {}
		for s in string.gmatch(ini:r_string(q, "lend_skip"), "[^,%s]+") do c.lend_skip[#c.lend_skip + 1] = s end
	end
	if c.type == "bonus" then
		c.requires = {}
		for s in string.gmatch(ini:r_string(q, "requires"), "[^,%s]+") do c.requires[#c.requires + 1] = s end
	end
	if c.type == "capture" then
		c.smart = ini:r_string(q, "smart")
		c.enemy = ini:r_string(q, "enemy")
	elseif c.type == "deliver" then
		c.item = ini:r_string(q, "item")
	elseif c.type == "fetch" or c.type == "kill" or c.type == "talk" then
		if c.type == "fetch" then
			c.item = ini:r_string(q, "item")
		else
			c.npc = ini:r_string(q, "npc")
			c.count = ini:line_exist(q, "count") and ini:r_u32(q, "count") or 1
			c.waves = ini:line_exist(q, "waves") and ini:r_u32(q, "waves") or 1
			c.loot = ini:line_exist(q, "loot") and ini:r_string(q, "loot") or nil
			-- optional ally: spawned with the targets at 'ally_spawn'; if it is alive at the end, info <q>_alive and 'bonus_money'
			if ini:line_exist(q, "ally") then
				c.ally = ini:r_string(q, "ally")
				local x, y, z = string.match(ini:r_string(q, "ally_spawn"), "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
				c.ally_pos = vector():set(tonumber(x), tonumber(y), tonumber(z))
				c.bonus_money = ini:line_exist(q, "bonus_money") and ini:r_u32(q, "bonus_money") or 0
			end
		end
		local pos = ini:r_string(q, "spawn")
		local x, y, z, lv, gv = string.match(pos, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*(%d+)%s*,%s*(%d+)")
		c.pos = vector():set(tonumber(x), tonumber(y), tonumber(z))
		c.lv, c.gv = tonumber(lv), tonumber(gv)
	end
	c.story_info = ini:line_exist(q, "story_info") and ini:r_string(q, "story_info") or nil
	c.money = ini:line_exist(q, "reward_money") and ini:r_u32(q, "reward_money") or 0
	-- rank points and reputation for the quest: the trader assortment depends on them; defaults follow the money reward
	c.rank = ini:line_exist(q, "reward_rank") and ini:r_u32(q, "reward_rank") or math.max(5, math.floor(c.money / 200))
	c.reputation = ini:line_exist(q, "reward_reputation") and ini:r_u32(q, "reward_reputation") or 5
	c.rewards = {}
	if ini:line_exist(q, "reward_items") then
		for s in string.gmatch(ini:r_string(q, "reward_items"), "[^,%s]+") do c.rewards[#c.rewards + 1] = s end
	end
	data[q] = c
	return c
end

local smart_held

-- a quest with 'faction' is only for an actor who has joined that faction (in any mode)
local function gate(c)
	return c.faction == nil or db.actor:character_community() == "actor_" .. c.faction
end

-- generic dialog precondition of a quest: mode switch, faction, quest state
local function available(q)
	if not is_enabled() then return false end
	local c = cfg(q)
	if c == nil or not gate(c) then return false end
	-- story_info: outside Freeplay the quest opens after this original story progress
	if c.story_info ~= nil and not has_alife_info("srp_freeplay") and not has_alife_info(c.story_info) then return false end
	if c.type == "capture" then return smart_held(q) end
	if c.type == "bonus" then
		for _, r in ipairs(c.requires) do
			if not has_alife_info(r .. "_reward") then return false end
		end
	end
	return true
end

local function quest_of(dialog_id)
	return (string.gsub(dialog_id, "_[a-z]+$", ""))
end

-- a giver that is not a fixed object (e.g. a squad member found by profile) is remembered when the quest starts
local function giver_id(c, q)
	if givers[q] ~= nil then return givers[q] end
	if c.giver_spawn then
		local t = items["giver." .. c.giver_spawn]
		return t and t[1] or nil
	end
	local s = alife():object(c.giver)
	return s and s.id or nil
end

local function smart_id(c)
	if c.smart == nil then return nil end
	local board = sim_board.get_sim_board()
	local sm = board and board.smarts_by_names[c.smart]
	return sm and sm.id or nil
end

local function task_id(q) return "fpq_" .. q end

local function set_task_stage(q, back)
	local task = db.actor:get_task(task_id(q), true)
	if task == nil then return end
	local c = cfg(q)
	if back then
		task:set_title(game.translate_string(q .. "_back"))
		task:set_description(game.translate_string(q .. "_back_text"))
		local gid = giver_id(c, q)
		if gid then task:change_map_location("secondary_task_location", gid) end
	else
		task:set_title(game.translate_string(q))
		task:set_description(game.translate_string(q .. "_text"))
	end
end

local function give_task(q)
	local c = cfg(q)
	local task = CGameTask()
	task:set_id(task_id(q))
	task:set_title(game.translate_string(q))
	task:set_description(game.translate_string(q .. "_text"))
	task:set_icon_name("ui_pda2_mtask_overlay")
	task:set_type(1)
	task:add_complete_func("fp_quests.task_complete")
	task:set_map_hint(q)
	task:set_map_location("secondary_task_location")
	task:set_map_object_id((items[q] and items[q][1]) or smart_id(c) or giver_id(c, q) or 0)
	db.actor:give_task(task, 0, false)
	if has_alife_info(q .. "_complete") then set_task_stage(q, true) end
end

-- engine polls this: true = task is completed
function task_complete(id)
	local q = string.sub(id, 5)
	return has_alife_info(q .. "_reward")
end

-------------------------------------------------------------- dialog actions
function start(actor, npc, dialog_id, phrase_id)
	local q = quest_of(dialog_id)
	local c = cfg(q)
	if c == nil then printf(TAG .. "no config for '%s'", tostring(q)) return end
	if (c.type == "fetch" or c.type == "kill" or c.type == "talk") and items[q] == nil then
		items[q] = {}
		for _ = 1, (c.count or 1) do
			local se = alife():create(c.item or c.npc, c.pos, c.lv, c.gv)
			if se then items[q][#items[q] + 1] = se.id end
		end
		if c.ally then
			local se = alife():create(c.ally, c.ally_pos, c.lv, c.gv)
			if se then items[q .. ".ally"] = { se.id } end
		end
	end
	if string.find(c.giver, "^profile:") and npc ~= nil then givers[q] = npc:id() end
	if c.lend then
		local has = false
		for _, s in ipairs(c.lend_skip) do if actor:object(s) ~= nil then has = true end end
		if not has then
			dialogs.relocate_item_section_to_actor(nil, nil, c.lend, 1)
			if c.lend_ammo then dialogs.relocate_item_section_to_actor(nil, nil, c.lend_ammo, 2) end
		end
	end
	db.actor:give_info_portion(q .. "_start")
	give_task(q)
end

-- a dialog action on the spawned NPC of a "talk" quest
function talked(actor, npc, dialog_id, phrase_id)
	local q = quest_of(dialog_id)
	local c = cfg(q)
	if c == nil or has_alife_info(q .. "_complete") then return end
	db.actor:give_info_portion(q .. "_complete")
	set_task_stage(q, true)
end

function has_item(q)
	local c = cfg(q)
	return c ~= nil and db.actor:object(c.item) ~= nil
end

function finish(actor, npc, dialog_id, phrase_id)
	local q = quest_of(dialog_id)
	local c = cfg(q)
	if c == nil then return end
	if c.item ~= nil then dialogs.relocate_item_section_from_actor(actor, npc, c.item) end
	if c.loot ~= nil then
		for _ = 1, (c.count or 1) do dialogs.relocate_item_section_from_actor(actor, npc, c.loot) end
	end
	if c.lend and actor:object(c.lend) ~= nil then dialogs.relocate_item_section_from_actor(actor, npc, c.lend) end
	local money = c.money
	if c.ally and has_alife_info(q .. "_alive") then money = money + c.bonus_money end
	if money > 0 then dialogs.relocate_money(npc, money, "in") end
	for _, s in ipairs(c.rewards) do dialogs.relocate_item_section_to_actor(actor, npc, s, 1) end
	db.actor:set_character_rank(db.actor:character_rank() + c.rank)
	db.actor:change_character_reputation(c.reputation)
	db.actor:give_info_portion(q .. "_reward")
	items[q] = nil
	items[q .. ".ally"] = nil
	givers[q] = nil
end

-- capture quests: precondition for the "give" dialog (the enemy still holds the smart)
smart_held = function(q)
	local c = cfg(q)
	if c == nil then return false end
	local board = sim_board.get_sim_board()
	local sm = board and board.smarts_by_names[c.smart]
	return sm ~= nil and sm.player_name == c.enemy
end

-- per-quest dialog preconditions (a dialog-level precondition gets no dialog id)
function has_esc_shilov_find_rukzak_item() return has_item("esc_shilov_find_rukzak") end
function esc_capture_army_blockpost_available() return available("esc_capture_army_blockpost") end
function esc_kill_blockpost_leader_available() return available("esc_kill_blockpost_leader") end
function val_sos_rescue_bus_available() return available("val_sos_rescue_bus") end
function agr_eliminate_outpost_available() return available("agr_eliminate_outpost") end
function yan_bring_sample_dnk_available() return available("yan_bring_sample_dnk") end
function gar_find_master_outfit_available() return available("gar_find_master_outfit") end
function gar_rescue_tunnel_novice_available() return available("gar_rescue_tunnel_novice") end
function val_find_ashot_dummy_available() return available("val_find_ashot_dummy") end
function val_searched_impounded_available() return available("val_searched_impounded") end
function mil_hog_find_item_available() return available("mil_hog_find_item") end
function has_mil_hog_find_item_item() return has_item("mil_hog_find_item") end
function agr_kill_wild_giant_available() return available("agr_kill_wild_giant") end
function yan_kill_tunnel_snorks_available() return available("yan_kill_tunnel_snorks") end
function mar_csky_kill_baron_available() return available("mar_csky_kill_baron") end
function esc_shilov_find_rukzak_available() return available("esc_shilov_find_rukzak") end
function mar_capture_pumping_station_available() return available("mar_capture_pumping_station") end
function mar_capture_church_available() return available("mar_capture_church") end
function mar_capture_boat_station_available() return available("mar_capture_boat_station") end
function mar_capture_embankment_available() return available("mar_capture_embankment") end
function mar_capture_north_khutor_available() return available("mar_capture_north_khutor") end
function mar_last_intensify_reward_available() return available("mar_last_intensify_reward") end

-------------------------------------------------------------- signals
function attach(m)
	mgr = m
	m:subscribe({ signal = "on_update", fun = fp_on_update })
	m:subscribe({ signal = "on_item_take", fun = fp_on_item_take })
	m:subscribe({ signal = "on_save", fun = fp_on_save })
	m:subscribe({ signal = "on_load", fun = fp_on_load })
end

-- capture/kill quests: the list is read from the config, the state is in info portions (kill: target id in the save)
local function target_gone(q)
	local ids = items[q]
	if ids == nil then return true end
	for _, id in ipairs(ids) do
		local se = alife():object(id)
		if se ~= nil and se:alive() then return false end
	end
	return true
end

-- next wave of a kill quest: spawned when the previous one is dead; the wave number is kept in info portions
local function next_wave(q, c)
	local w = 1
	while has_alife_info(q .. "_wave" .. (w + 1)) do w = w + 1 end
	if w >= c.waves then return false end
	db.actor:give_info_portion(q .. "_wave" .. (w + 1))
	items[q] = {}
	for _ = 1, c.count do
		local se = alife():create(c.npc, c.pos, c.lv, c.gv)
		if se then items[q][#items[q] + 1] = se.id end
	end
	return true
end

local capture_list = nil
function fp_on_update(delta)
	if mgr then mgr:reschedule(2000) end
	if db.actor == nil then return end
	if not has_alife_info("fp_quests") then db.actor:give_info_portion("fp_quests") end
	-- givers that are new NPCs: created once (in Freeplay, or in Story after the story_info of the quest), never respawned
	if spawn_list == nil then
		spawn_list = {}
		for i = 0, ini:line_count("quests") - 1 do
			local _, q = ini:r_line("quests", i, "", "")
			local c = cfg(q)
			if c ~= nil and c.giver_spawn then spawn_list[#spawn_list + 1] = c end
		end
	end
	for _, c in ipairs(spawn_list) do
		local key = "giver." .. c.giver_spawn
		if c.replaces and has_alife_info("srp_freeplay") then
			local old = alife():object(c.replaces)
			if old then alife():release(old, true) end
		end
		if items[key] == nil and (has_alife_info("srp_freeplay") or (c.story_info and has_alife_info(c.story_info))) then
			local se = alife():create(c.giver_spawn, c.giver_at, c.giver_lv, c.giver_gv)
			if se then items[key] = { se.id } end
		end
	end
	if capture_list == nil then
		capture_list = {}
		for i = 0, ini:line_count("quests") - 1 do
			local _, q = ini:r_line("quests", i, "", "")
			local c = cfg(q)
			if c ~= nil and (c.type == "capture" or c.type == "kill" or c.type == "deliver") then capture_list[#capture_list + 1] = q end
		end
	end
	for _, q in ipairs(capture_list) do
		if has_alife_info(q .. "_start") and not has_alife_info(q .. "_complete") then
			local c = cfg(q)
			local done
			if c.type == "kill" then
				done = target_gone(q) and not next_wave(q, c) and (c.loot == nil or db.actor:object(c.loot) ~= nil)
			elseif c.type == "deliver" then
				done = db.actor:object(c.item) ~= nil
			else
				done = not smart_held(q)
			end
			if done then
				if c.ally and items[q .. ".ally"] and not target_gone(q .. ".ally") then db.actor:give_info_portion(q .. "_alive") end
				db.actor:give_info_portion(q .. "_complete")
				set_task_stage(q, true)
			end
		end
	end
end

function fp_on_item_take(obj)
	if not is_enabled() then return end
	local sect = obj:section()
	for q in pairs(items) do
		local c = cfg(q)
		if c ~= nil and c.item == sect and items[q] ~= nil and obj:id() == items[q][1] and not has_alife_info(q .. "_complete") then
			db.actor:give_info_portion(q .. "_complete")
			set_task_stage(q, true)
		end
	end
end

function fp_on_save(packet)
	local list = {}
	for q, ids in pairs(items) do list[#list + 1] = q end
	packet:w_u8(#list)
	for _, q in ipairs(list) do
		packet:w_stringZ(q)
		packet:w_u16(givers[q] or 65535)
		packet:w_u8(#items[q])
		for _, id in ipairs(items[q]) do packet:w_u16(id) end
	end
end

function fp_on_load(reader)
	local n = reader:r_u8()
	for _ = 1, n do
		local q = reader:r_stringZ()
		local gv = reader:r_u16()
		if gv ~= 65535 then givers[q] = gv end
		items[q] = {}
		for _ = 1, reader:r_u8() do items[q][#items[q] + 1] = reader:r_u16() end
	end
end
