-- Copyright 2026 Eon (SRP Freeplay: Eon), Freeplay Extras
-- fp_tasks: the single point where Freeplay modules talk to the engine about tasks.
-- A facade over the stock Clear Sky API (CGameTask, give_task, set_task_state, game news). It owns no task state:
-- the engine keeps the tasks in the savegame together with the names of their complete / fail functions, and the module
-- that gives a task (fp_quests, ogsm_rt_manager, later others) keeps its own world state. It does not use or copy the
-- core task manager (task_manager.script) - core tasks stay with the core.
--
--   give{ id, title, text, news_icon, kind, prio, time, target, spot, hint, complete, fail, silent }
--       id        engine task id (unique, a string)
--       title     already translated title;  text - already translated description
--       kind      1 = additional (default), 0 = storyline;  prio - priority (default 0)
--       target    server id of the object for the map mark (optional), spot - map spot type (default secondary_task_location),
--                 hint - string id of the map hint (default id)
--       time      time limit in game seconds, 0/nil = none
--       complete / fail   "module.function": the engine polls it with the task id, true = the task is done / failed
--       news_icon icon of the news line;  silent - no "new task" news
--   update(id, { title, text, target, spot, silent })   change a given task, news "update" unless silent
--   finish(id, ok, news_text)                            set the engine state (completed / failed) and send the news
--   news(kind, text, icon)                               kind: new / update / completed / failed / reversed
--   state(id)                                            nil (no such task) or "active" / "completed" / "failed"

local TAG = "[fp_tasks] "
local DEFAULT_SPOT = "secondary_task_location"
local DEFAULT_ICON = "ui_iconsTotal_found_thing"

local captions = {
	new = "rt_task_new", update = "rt_task_update", completed = "rt_task_completed",
	failed = "rt_task_failed", fail = "rt_task_failed", reversed = "rt_task_reversed",
}

-- news line with the icon; during a dialog also a message in the talk window
-- (give_talk_message2 takes 4 arguments, the 4th is the template as in news_manager)
function news(kind, text, icon)
	local act = db.actor
	if act == nil then return end
	local title = game.translate_string(captions[kind] or "rt_task_update")
	icon = icon or DEFAULT_ICON
	fp_log.always("%s", TAG .. "news " .. tostring(kind) .. ": " .. tostring(text) .. " (talking: " .. tostring(act:is_talking()) .. ")")
	pcall(xr_sound.set_sound_play, act:id(), "pda_task")
	local ok, err = pcall(act.give_game_news, act, title, text, icon, 0, 5000, 1)
	if not ok then fp_log.always("%s", TAG .. "give_game_news failed: " .. tostring(err)) end
	if act:is_talking() then
		ok, err = pcall(act.give_talk_message2, act, title, text, icon, "iconed_answer_item")
		if not ok then fp_log.always("%s", TAG .. "give_talk_message2 failed: " .. tostring(err)) end
	end
end

function give(s)
	if db.actor == nil or s == nil or s.id == nil then return false end
	local t = CGameTask()
	t:set_id(s.id)
	t:set_title(s.title or s.id)
	t:set_description(s.text or "")
	t:set_icon_name("ui_pda2_mtask_overlay")
	t:set_type(s.kind or 1)
	t:set_priority(s.prio or 0)
	t:set_map_hint(s.hint or s.id)
	if s.complete then t:add_complete_func(s.complete) end
	if s.fail then t:add_fail_func(s.fail) end
	if s.target then
		t:set_map_location(s.spot or DEFAULT_SPOT)
		t:set_map_object_id(s.target)
	end
	db.actor:give_task(t, s.time or 0, false)
	if not s.silent then news("new", s.title or s.id, s.news_icon) end
	return true
end

function update(id, s)
	local act = db.actor
	local t = act and act:get_task(id, true)
	if t == nil then return false end
	if s.title then t:set_title(s.title) end
	if s.text then t:set_description(s.text) end
	if s.target then t:change_map_location(s.spot or DEFAULT_SPOT, s.target) end
	if not s.silent then news("update", s.title or t:get_title(), s.news_icon) end
	return true
end

function finish(id, ok, news_text, icon)
	local act = db.actor
	if act == nil then return end
	local t = act:get_task(id, true)
	if t == nil then return end
	act:set_task_state(ok and task.completed or task.fail, id)
	news(ok and "completed" or "failed", news_text or t:get_title(), icon)
end

function state(id)
	local act = db.actor
	if act == nil or act:get_task(id, true) == nil then return nil end
	local s = act:get_task_state(id)
	if s == task.completed then return "completed" end
	if s == task.fail then return "failed" end
	return "active"
end
