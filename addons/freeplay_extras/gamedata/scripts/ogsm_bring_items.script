-- documents and what the buyers pay for one (original OGSM prices)
local doc_price = {
	doc_1 = 3000,
	doc_2 = 3000,
	doc_3 = 3300,
	doc_4 = 3000,
	doc_5 = 3000,
	doc_6 = 3000,
	doc_7 = 3000,
	doc_8 = 3000,
	doc_9 = 3000,
