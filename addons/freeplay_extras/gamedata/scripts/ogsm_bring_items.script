-- called once per game (see freeplay_mode.prepare_world). Documents, books and flash drives are placed by
-- ensure_flashes / ensure_loot (dead stalkers' pockets) on the first net_spawn, also in old saves.
function startup_spawn()
	if has_alife_info(INFO_SPAWNED) then
		return
	end
	db.actor:give_info_portion(INFO_SPAWNED)
end

-- ---------------------------------------------------------------------------------------------------------------
-- Flash drives of the mechanics in the pockets of dead stalkers
-- ---------------------------------------------------------------------------------------------------------------
local INFO_FLASHES = "fp_loot_flashes"
local INFO_CORPSES = "fp_loot_corpses"
local BODY_SECTION = "sim_default_stalker_1"
local task_level = { mar = "marsh", esc = "escape", gar = "garbage", val = "darkvalley", agr = "agroprom" }

function attach(m)
	m:subscribe({ signal = "on_net_spawn", fun = ensure_flashes })
end

-- section -> level for every flash drive of the upgrade tasks (the level comes from the prefix of the task name)
function flash_levels()
	local res, order = {}, {}
	local ini = ini_file("misc\\tm_upgrades.ltx")
	local skip = {}
	local own = ini_file("misc\\fp_loot.ltx")
	if own:section_exist("flash_skip") then
		for i = 0, own:line_count("flash_skip") - 1 do
			local _, s = own:r_line("flash_skip", i, "", "")
			skip[s] = true
		end
	end
	if ini:section_exist("list_tm_upgrades") then
		for i = 0, ini:line_count("list_tm_upgrades") - 1 do
			local _, task = ini:r_line("list_tm_upgrades", i, "", "")
			if ini:section_exist(task) and ini:line_exist(task, "requested_item") then
				local item = ini:r_string(task, "requested_item")
				local lvl = task_level[string.match(task, "^(%a+)_")]
				if lvl and not skip[item] and not res[item] then
					res[item] = lvl
					order[#order + 1] = item
				end
			end
		end
	end
	if own:section_exist("flashes") then
		for i = 0, own:line_count("flashes") - 1 do
			local _, s = own:r_line("flashes", i, "", "")
			if not res[s] then res[s] = "any" order[#order + 1] = s end
		end
	end
	return res, order
end

-- one dead stalker at spot c with the item in the pocket
local function put_in_corpse(section, c)
	local body = ogsm_packet.spawn_stalker(BODY_SECTION, c[1], c[2], c[3], "dead", "empty")
	if not body then return end
	local item = alife():create(section, body.position, body.m_level_vertex_id, body.m_game_vertex_id, body.id)
	fp_log.write("[fp_loot] %s: corpse %s on %s (%.1f, %.1f, %.1f), item %s", section, body.id, c[4], c[1].x, c[1].y, c[1].z, item and item.id or "nil")
end

-- spots that are not taken yet (a spot is taken by a corpse placed earlier in the same pass)
local function free_spots()
	local free = {}
	for i = 1, #coords do free[i] = i end
	return free
end

local function take_spot(free, level)
	local cand = {}
	for k, i in ipairs(free) do
		if level == nil or level == "any" or coords[i][4] == level then cand[#cand + 1] = k end
	end
	if #cand == 0 then
		for k in ipairs(free) do cand[#cand + 1] = k end
	end
	if #cand == 0 then return nil end
	local k = cand[math.random(#cand)]
	local c = coords[free[k]]
	table.remove(free, k)
	return c
end

-- once per game (also for saves made before the module): a dead stalker with the flash drive in the pocket per flash
function ensure_flashes()
	if not (has_alife_info("srp_freeplay") or has_alife_info("fp_loot")) then return end
	if not db.actor or not alife() then return end
	if not has_alife_info(INFO_FLASHES) then
		db.actor:give_info_portion(INFO_FLASHES)
		local level_of, order = flash_levels()
		local free = free_spots()
		for _, section in ipairs(order) do
			local c = take_spot(free, level_of[section])
			if c then put_in_corpse(section, c) end
		end
	end
	ensure_loot()
end

-- documents and skill books, also once per game. In saves where they already lie on the ground (older builds placed
-- them at the spots) the ones lying on the ground are released and put into corpses; the ones somebody holds stay.
function ensure_loot()
	if has_alife_info(INFO_CORPSES) then return end
	db.actor:give_info_portion(INFO_CORPSES)
	local sim = alife()
	local want = {}
	for _, s in ipairs(doc_list) do want[s] = true end
	for _, s in ipairs(fp_skills.book_list()) do want[s] = true end
	if has_alife_info(INFO_SPAWNED) then
		for id = 1, 65534 do
			local o = sim:object(id)
			if o ~= nil then
				local s = o:section_name()
				if want[s] then
					if o.parent_id == 65535 then sim:release(o, true) else want[s] = nil end
				end
			end
		end
	end
	local free = free_spots()
	for section in pairs(want) do
		local c = take_spot(free, "any")
		if c then put_in_corpse(section, c) end
	end
end

-- every section that fp_loot puts into corpses: flash drives, documents, skill books
function corpse_items()
	local level_of, order = flash_levels()
	local all = {}
	for _, s in ipairs(order) do all[#all + 1] = s end
	for _, s in ipairs(doc_list) do all[#all + 1] = s end
	for _, s in ipairs(fp_skills.book_list()) do all[#all + 1] = s end
	return all
end

-- list for the dev tools: { section, corpse id, position } for every such item that lies in a corpse
function flash_holders()
	local sim = alife()
	local level_of = {}
	for _, s in ipairs(corpse_items()) do level_of[s] = true end
	local res = {}
	for id = 1, 65534 do
		local o = sim:object(id)
		if o ~= nil and level_of[o:section_name()] and o.parent_id ~= 65535 then
			local holder = sim:object(o.parent_id)
			if holder ~= nil then
				res[#res + 1] = { section = o:section_name(), id = holder.id, pos = holder.position,
					lvl_id = game_graph():vertex(holder.m_game_vertex_id):level_id() }
			end
		end
	end
	table.sort(res, function(a, b)
		local ka, kb = string.find(a.section, "^flesh_up") and 0 or 1, string.find(b.section, "^flesh_up") and 0 or 1
		if ka ~= kb then return ka < kb end
		return a.section < b.section
	end)
	return res
end

-- documents in the actor's inventory (dialog precondition)
function check_documents()
	local actor = db.actor
	for _, section in ipairs(doc_list) do
		if actor:object(section) ~= nil then
			return true
		end
	end
	return false
end

-- sell all documents to the speaker (dialog action)
function relocate_documents(first_speaker, second_speaker)
	local actor = db.actor
	local total = 0
	for _, section in ipairs(doc_list) do
		if actor:object(section) ~= nil then
			dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, section)
			total = total + doc_price[section]
		end
	end
	if total > 0 then
		dialogs.relocate_money(first_speaker, total, "in")
	end
end
