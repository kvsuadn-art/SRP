-- Copyright 2026 Eon (SRP Freeplay: Eon), Freeplay Extras 0.1.
-- Based on solutions and ideas of: ogse_signals: Malandrinus, OGS Evolution Team (signals and slots); SRP (Decane): the actor binder.
-- Сборка на основе решений и идей: ogse_signals: Malandrinus, OGS Evolution Team (система сигналов и слотов); SRP (Decane): биндер актора. Авторам спасибо за их труд.
-- Freeplay base layer (fp_*): actor binder subclass and signal emitter.
-- Original bind_stalker.script is untouched: only script_binding in
-- configs/creatures/actor.ltx is overridden by the addon.
--
-- The subclass calls the base method first, then emits a signal through
-- ogse_signals. Modules subscribe in their own attach(mgr) (see
-- ogse_signals_addons_list.addons), this file never needs to change for them.
--
-- Signals (arguments):
--   on_net_spawn()                 after the base net_spawn succeeded
--   on_net_destroy()               BEFORE the base net_destroy (actor still alive)
--   on_update(delta)               every tick after the base update; use mgr:reschedule(ms)
--   on_item_use(obj)               the actor used an item (callback.use_object, registered by this
--                                  subclass: the base class keeps it commented out)
--   on_item_take(obj)              skipped while the game is synchronizing (as in base)
--   on_item_drop(obj)              skipped while quitting the game (as in base)
--   on_trade(item, sell_bye, money)
--   on_task(task, state)
--   on_take_from_box(box, item)
--   on_save(packet)                after the base save; a subscriber that writes
--                                  to the packet changes the savegame format
--   on_load(reader)                after the base load, must read exactly what on_save wrote
--
-- Errors in subscribers are NOT swallowed on purpose: a swallowed error would leave
-- ogse_signals with a half-processed queue.
-- Адаптация под SRP Freeplay: Eon
-- Описание на русском:
-- Базовый слой Freeplay: подкласс биндера актора и источник сигналов. Оригинальный bind_stalker.script не тронут: аддон переопределяет
-- только script_binding в configs/creatures/actor.ltx. Подкласс вызывает базовый метод, затем отправляет сигнал через ogse_signals.
-- Модули подписываются в своём attach(mgr) (список в ogse_signals_addons_list.addons), этот файл для них менять не нужно.
-- Сигналы перечислены выше (аргументы в скобках). Ошибки в подписчиках намеренно не проглатываются: проглоченная ошибка оставила бы
-- очередь ogse_signals обработанной наполовину.

function actor_init(obj)
	obj:bind_object(fp_actor_binder(obj))
end

local TAG = "[fp_binder] "
local mgr = nil

local function emit(name, ...)
	if not mgr then
		mgr = ogse_signals.get_mgr()
	end
	mgr:call(name, ...)
end

class "fp_actor_binder" (bind_stalker.actor_binder)

function fp_actor_binder:__init(obj) super(obj)
	fp_log.write("%s", TAG .. "init ok, subclass of bind_stalker.actor_binder")
end

function fp_actor_binder:reinit()
	bind_stalker.actor_binder.reinit(self)
	self.object:set_callback(callback.use_object, self.on_use_object, self)
end

function fp_actor_binder:on_use_object(obj)
	emit("on_item_use", obj)
end

function fp_actor_binder:net_spawn(se_abstract)
	if not bind_stalker.actor_binder.net_spawn(self, se_abstract) then
		return false
	end
	emit("on_net_spawn")
	return true
end

function fp_actor_binder:net_destroy()
	emit("on_net_destroy")
	bind_stalker.actor_binder.net_destroy(self)
end

function fp_actor_binder:update(delta)
	bind_stalker.actor_binder.update(self, delta)
	emit("on_update", delta)
end

function fp_actor_binder:on_item_take(obj)
	bind_stalker.actor_binder.on_item_take(self, obj)
	if device().precache_frame > 1 then return end
	emit("on_item_take", obj)
end

function fp_actor_binder:on_item_drop(obj)
	bind_stalker.actor_binder.on_item_drop(self, obj)
	if bind_stalker.quitting_game then return end
	emit("on_item_drop", obj)
end

function fp_actor_binder:on_trade(item, sell_bye, money)
	bind_stalker.actor_binder.on_trade(self, item, sell_bye, money)
	emit("on_trade", item, sell_bye, money)
end

function fp_actor_binder:task_callback(_task, _state)
	-- The core callback reads tm.task_info[id] without a nil check, so it only gets the tasks of the task manager.
	-- Tasks of Freeplay modules (fp_quests, ogsm_rt_manager) are not there and go to the on_task signal only.
	local tm = task_manager.get_task_manager()
	if tm ~= nil and tm.task_info[_task:get_id()] ~= nil then
		bind_stalker.actor_binder.task_callback(self, _task, _state)
	end
	emit("on_task", _task, _state)
end

function fp_actor_binder:take_item_from_box(box, item)
	bind_stalker.actor_binder.take_item_from_box(self, box, item)
	emit("on_take_from_box", box, item)
end

-- Size of the actor chunk of the last save (bytes): the base part (it holds pstor) and the part of our modules.
-- The engine limit is about 6 KB per object chunk (see README), so both are measured with net_packet:w_tell().
-- Размер блока актора при последнем сохранении (байт): базовая часть (в ней pstor) и часть наших модулей.
local last_base, last_addons = nil, nil
function last_save_sizes() return last_base, last_addons end

function fp_actor_binder:save(packet)
	local ok0, p0 = pcall(packet.w_tell, packet)
	bind_stalker.actor_binder.save(self, packet)
	local ok1, p1 = pcall(packet.w_tell, packet)
	emit("on_save", packet)
	local ok2, p2 = pcall(packet.w_tell, packet)
	if ok0 and ok1 and ok2 and p0 and p1 and p2 then
		last_base, last_addons = p1 - p0, p2 - p1
		fp_log.always("%s", TAG .. string.format("SAVE actor chunk: base %d (with pstor) + addons %d = %d of ~6144 (%.1f%%)",
			last_base, last_addons, last_base + last_addons, (last_base + last_addons) * 100 / 6144))
	end
end

function fp_actor_binder:load(reader)
	bind_stalker.actor_binder.load(self, reader)
	emit("on_load", reader)
end
