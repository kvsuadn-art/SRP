-- Freeplay base layer: list of modules attached to ogse_signals.
-- ogse_signals.get_mgr() reads "addons" and calls <module>.attach(mgr) for each name.
-- The module name is kept as in OGSE, ogse_signals expects it.
-- Adding a module = adding its script name here, nothing else changes.

addons = {
	"fp_surge",
	"fp_dev",
	"fp_dev_tools",
	"fp_satiety",
	"ogsm_rt_manager",
	"fp_mutants",
	"fp_skills",
	"fp_quests",
	"fp_medals",
	"fp_deserves",
	"fp_sleep",
	"fp_items",
	"fp_stash", "fp_cleaner",
	"ogsm_rare_items_manager",
	"fp_fatigue", -- must stay last: its save chunk is read only if present (older saves)
}
