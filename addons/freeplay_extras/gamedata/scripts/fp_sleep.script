-- Based on solutions and ideas of: Sigerous Mod 3.10 (GeJorge): sgm_sleep_places, sgm_callbacks, sgm_effects; "New Sleep Mod for R.M.A. 1.1.5" (Mechanic, Shoker, Z.E.N., Ab@dDon, Junk); OGSM Extended 2.0 (Minister, Kirgudu, DEXXX, xStream, Ab@dDon, Alex Ros et al.): ogsm_sleep.
-- Сборка на основе решений и идей: Sigerous Mod 3.10 (GeJorge): sgm_sleep_places, sgm_callbacks, sgm_effects; "New Sleep Mod for R.M.A. 1.1.5" (Mechanic, Shoker, Z.E.N., Ab@dDon, Junk); OGSM Extended 2.0 (Minister, Kirgudu, DEXXX, xStream, Ab@dDon, Alex Ros и др.): ogsm_sleep. Авторам спасибо за их труд.
-- fp_sleep: sleep in known places. Idea, points and zones: SGM (Sigerous Mod 3.10, GeJorge, sgm_sleep_places, sgm_callbacks, sgm_effects).
-- Адаптация под SRP Freeplay: Eon
--
-- The sleeping bag (item "sleeping_bag", misc\fp_sleep.ltx) is "used": if the actor is in a sleeping place (hand-made points
-- and zones of the config) and it is night, he sleeps 1-6 hours: the screen fades, time runs fast, health, power and psy-health
-- are restored. Unlike SGM nothing runs per frame: the place is checked at the moment of use (SGM polled 38 distances 
-- every update and showed a HUD static), the poller runs only while the actor sleeps (1 s).
-- Second way (SoC style): an invisible object fp_mattress over a bed (world mattresses, [mattress_<level>] of the config), "F" shows
-- the tip and opens the hour window ui_sleep (idea, model and window: "New Sleep Mod for R.M.A. 1.1.5", Mechanic, Shoker, Z.E.N.,
-- Ab@dDon, Junk). No core hooks: the objects are created once per level (info fp_mat_<level>) and take the use
-- callback from their own binder fp_mattress; nothing is saved by the module. Switch: info portion srp_freeplay or fp_sleep. Savegame: nothing of its own. Not handled: a save made during sleep keeps the
-- fast time factor (input is disabled, so only an autosave can catch it).
-- Описание на русском:
-- Сон в известных местах. Идея, точки и зоны из SGM. Спальник (предмет sleeping_bag, misc\fp_sleep.ltx) «используется»: если
-- персонаж в месте для сна (точки и зоны из конфига) и сейчас ночь, он спит 1–6 часов: экран темнеет, время идёт быстро, здоровье,
-- сила и пси-здоровье восстанавливаются. В отличие от SGM ничего не опрашивается каждый кадр: место проверяется в момент
-- использования, опрос идёт только пока персонаж спит (раз в секунду). Второй способ (в стиле ТЧ): невидимый объект fp_mattress над
-- кроватью (матрасы мира, [mattress_<уровень>] конфига), «F» показывает подсказку и открывает окно часов ui_sleep (идея, модель и окно:
-- New Sleep Mod). Без хуков в ядро: объекты создаются один раз на уровень (info fp_mat_<уровень>) и берут колбэк «использовать» из
-- своего биндера fp_mattress; модуль ничего не сохраняет. Включение: info srp_freeplay или fp_sleep. Не обработано: сохранение,
-- сделанное во время сна, сохраняет быстрый фактор времени (ввод отключён, поймать может только автосохранение).

local TAG = "[fp_sleep] "
local IDLE_MS = 5000
local SLEEP_MS = 1000
local FADE_ID = 76424
local ini = ini_file("misc\\fp_sleep.ltx")
local mgr = nil
local sleeping = false
local idle_ticks = 0
local wake_at = 0
local prev_factor = 8
local radius_sqr = nil
local slept_hours = 0
local ENEMY_RADIUS = 15
local MAT_SECTION = "fp_mattress"
local mats_created = 0
local mats_done = false   -- the creation check runs once per level load

function is_enabled()
	return has_alife_info("srp_freeplay") or has_alife_info("fp_sleep")
end

function attach(m)
	mgr = m
	dbglog("%s", "[fp_sleep] attached")
	m:subscribe({ signal = "on_item_use", fun = on_item_use })
	m:subscribe({ signal = "on_update", fun = on_update })
end

local function tip(id)
	news_manager.send_tip(db.actor, game.translate_string(id))
end

-- the actor is at a point of the current level, inside a zone or on a listed level
local function in_sleep_place()
	local level_name = level.name()
	for i = 0, ini:line_count("levels") - 1 do
		local _, name = ini:r_line("levels", i, "", "")
		if name == level_name then return true end
	end
	if ini:line_exist("zones", level_name) then
		local zone = db.zone_by_name[ini:r_string("zones", level_name)]
		if zone ~= nil and zone:inside(db.actor:position()) then return true end
	end
	local sect = "points_" .. level_name
	if ini:section_exist(sect) then
		radius_sqr = radius_sqr or ini:r_float("settings", "radius_sqr")
		local pos = db.actor:position()
		for i = 0, ini:line_count(sect) - 1 do
			local _, _, v = ini:r_line(sect, i, "", "")
			local x, y, z = string.match(v, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
			if pos:distance_to_sqr(vector():set(tonumber(x), tonumber(y), tonumber(z))) < radius_sqr then return true end
		end
	end
	return false
end

-- for fp_hud: the icon of the sleeping place
function in_place() return in_sleep_place() end
function is_sleeping() return sleeping end

local function is_night()
	local h = level.get_time_hours()
	return h >= ini:r_u32("settings", "night_from") or h < ini:r_u32("settings", "night_to")
end

function on_item_use(obj)
	if not is_enabled() or sleeping then return end
	if obj:section() ~= "sleeping_bag" then return end
	local hud = get_hud()
	hud:HideActorMenu()
	hud:HidePdaMenu()
	if not in_sleep_place() then
		local zn = ini:line_exist("zones", level.name()) and ini:r_string("zones", level.name()) or "-"
		local z = db.zone_by_name[zn]
		local p = db.actor:position()
		dbglog("%s", string.format("[fp_sleep] no place: level=%s pos=%.2f,%.2f,%.2f zone=%s registered=%s inside=%s", level.name(), p.x, p.y, p.z, zn, tostring(z ~= nil), tostring(z ~= nil and z:inside(p))))
		tip("st_fp_sleep_no_place") return
	end
	if not is_night() then tip("st_fp_sleep_not_tired") return end
	start_sleep(math.random(ini:r_u32("settings", "min_hours"), ini:r_u32("settings", "max_hours")))
end

-- the window and the bag both end here: sleep for `hours` game hours (the poller of on_update wakes the actor up)
function start_sleep(hours)
	if sleeping or db.actor == nil or hours < 1 then return end
	local act = db.actor
	sleeping = true
	slept_hours = hours
	prev_factor = level.get_time_factor()
	wake_at = game.time() + hours * 3600 * 1000
	if act.health < 1 then act.health = 1 end
	if act.power < 1 then act.power = 1 end
	act.psy_health = 1
	level.disable_input()
	pcall(act.hide_weapon, act)
	level.add_pp_effector("mar_fade.ppe", FADE_ID, false)
	level.set_time_factor(ini:r_float("settings", "time_factor"))
	level.hide_indicators_safe()
end

local function wake_up()
	sleeping = false
	level.remove_pp_effector(FADE_ID)
	level.set_time_factor(prev_factor)
	level.enable_input()
	level.show_indicators()
	pcall(db.actor.restore_weapon, db.actor)
	level.add_cam_effector("camera_effects\\fusker.anm", 76431, false, "")
	tip("st_fp_sleep_woke")
	if fp_fatigue ~= nil then fp_fatigue.on_rest(slept_hours) end
end


-- ---------------------------------------------------------------------------------------------------------------------
-- world mattresses
-- ---------------------------------------------------------------------------------------------------------------------

-- the reason (string id) why the actor cannot sleep now, or nil
local function cannot_sleep()
	local act = db.actor
	local pos = act:position()
	for id, st in pairs(db.storage) do
		local o = st.object
		if o ~= nil and id ~= act:id() and o:alive() then
			if IsMonster(o) or (IsStalker(o) and o:relation(act) == game_object.enemy) then
				if o:position():distance_to(pos) < ENEMY_RADIUS then return "st_fp_sleep_enemy" end
			end
		end
	end
	if act.radiation > 0 then return "st_fp_sleep_radiation" end
	return nil
end

-- callback.use_object of the mattress: F on the invisible object
function on_mattress_use(obj, who)
	if not is_enabled() or sleeping or db.actor == nil then return end
	local why = cannot_sleep()
	if why then tip(why) return end
	level.start_stop_menu(ui_sleep.sleep(get_hud()), true)
end

local function parse_point(v)
	local nums = {}
	for n in string.gmatch(v, "[%-%d%.]+") do nums[#nums + 1] = tonumber(n) end
	return nums
end

local function flag(level_name) return "fp_mat_" .. level_name end

-- create the mattresses of this level once (info fp_mat_<level>); the object takes its callback from its own binder fp_mattress
local function create_all()
	local lname = level.name()
	local sect = "mattress_" .. lname
	if not ini:section_exist(sect) or has_alife_info(flag(lname)) then return end
	local sim, act = alife(), db.actor
	for i = 0, ini:line_count(sect) - 1 do
		local _, name, v = ini:r_line(sect, i, "", "")
		local n = parse_point(v)
		local p = vector():set(n[1], n[2], n[3])
		local lv = n[4] or level.vertex_id(p)
		-- no vertex under the point (the engine answers with -1): the actor's vertex, as the rucksacks of the base do in all.spawn
		if lv == nil or lv >= 4294967295 or lv < 0 then lv = act:level_vertex_id() end
		local gv = n[5] or act:game_vertex_id()
		local se = sim:create(MAT_SECTION, p, lv, gv)
		mats_created = mats_created + 1
		dbglog("%s", string.format("[fp_sleep] mattress %s: %s lv=%s gv=%s id=%s", sect .. "." .. name, tostring(se ~= nil), tostring(lv), tostring(gv), tostring(se and se.id)))
	end
	act:give_info_portion(flag(lname))
end

-- for the dev tools: remove the mattress objects of ALL levels and create them again on this level (a full scan, one-off)
function recreate_mattresses()
	local sim, n = alife(), 0
	for i = 0, 65534 do
		local se = sim:object(i, true)
		if se ~= nil and se:section_name() == MAT_SECTION then sim:release(se, true) n = n + 1 end
	end
	for lname in string.gmatch("marsh escape garbage agroprom agroprom_underground darkvalley red_forest military limansk hospital yantar stancia stancia_2 generators", "%S+") do
		if has_alife_info(flag(lname)) then db.actor:disable_info_portion(flag(lname)) end
	end
	mats_created = 0
	create_all()
	dbglog("%s", "[fp_sleep] mattresses recreated: removed " .. n .. ", created " .. mats_created)
	return n, mats_created
end

function mattress_count() return fp_mattress.online_count() end


-- the slot runs every second (reschedule is per slot, so a longer idle period would make the wake-up late: 5 s = 2 game hours at x1700)
function on_update(delta)
	if mgr then mgr:reschedule(SLEEP_MS) end
	if not is_enabled() then return end
	local act = db.actor
	if not (act and act:alive()) then
		if sleeping then
			sleeping = false
			level.remove_pp_effector(FADE_ID)
			level.set_time_factor(prev_factor)
			level.enable_input()
		end
		return
	end
	if sleeping then
		if game.time() >= wake_at then wake_up() end
		return
	end
	if not mats_done and is_enabled() then mats_done = true create_all() end
	idle_ticks = idle_ticks + 1
	if idle_ticks >= IDLE_MS / SLEEP_MS then
		idle_ticks = 0
		if act:object("sleeping_bag") == nil then
			dialogs.relocate_item_section_to_actor(nil, nil, "sleeping_bag", 1)
		end
	end
end
