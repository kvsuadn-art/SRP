-- fp_items: using medicine hides the weapon for a moment. Idea: OGSM Extended 2.0 (ogsm_items, DEXXX).
-- —борка решений и идей: OGSM Extended 2.0 (Minister, Kirgudu, DEXXX, xStream, Ab@dDon, Alex Ros и др.): ogsm_items (скрытие оружи€ при лечении). —крипт собран на их основе, авторам спасибо.
-- јдаптаци€ под SRP Freeplay: Eon
--
-- Using a medkit, bandage or antirad (misc\fp_items.ltx [hide]) hides the weapon, so the animation is not disturbed and
-- a reload is interrupted; after hide_ms it is restored. Switch: info portion srp_freeplay or fp_items; off: fp_items_off.
-- Cost: one on_item_use subscriber and a 1 s slot that only compares a timer. Savegame: nothing of its own.

local ini = ini_file("misc\\fp_items.ltx")
local mgr = nil
local restore_at = nil
local hide_list = nil

function is_enabled()
	return (has_alife_info("srp_freeplay") or has_alife_info("fp_items")) and not has_alife_info("fp_items_off")
end

function attach(m)
	mgr = m
	m:subscribe({ signal = "on_item_use", fun = on_item_use })
	m:subscribe({ signal = "on_update", fun = on_update })
end

function on_item_use(obj)
	if not is_enabled() then return end
	if hide_list == nil then
		hide_list = {}
		for i = 0, ini:line_count("hide") - 1 do
			local _, name = ini:r_line("hide", i, "", "")
			hide_list[name] = true
		end
	end
	if not hide_list[obj:section()] then return end
	-- hide_weapon of the engine is a counter: a second hide while one is pending would need a second restore, and the
	-- weapon stayed holstered for good (two medkits in a row). One hide per cycle, the next use only moves the timer.
	if restore_at == nil then db.actor:hide_weapon() end
	restore_at = time_global() + ini:r_u32("settings", "hide_ms")
end

function on_update(delta)
	if mgr then mgr:reschedule(1000) end
	if restore_at ~= nil and time_global() >= restore_at then
		restore_at = nil
		if db.actor and db.actor:alive() then db.actor:restore_weapon() end
	end
end
